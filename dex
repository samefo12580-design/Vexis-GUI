if e.obj.Parent == nil then kept[#kept+1] = e end
end
if #kept == 0 then return end
Explorer.PushHistory({
label = label .. " " .. #kept,
undo = function() restoreEntries(kept) end,
redo = function() destroyEntries(kept) end,
})
end
end)
end
