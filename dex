end)
if Properties and Properties.SetProp and not Properties._historyWrapped then
local origSet = Properties.SetProp
Properties.SetProp = function(prop, val, noupdate, prevAttribute)
if history.Busy or prevAttribute then
return origSet(prop, val, noupdate, prevAttribute)
end
local items = {}
pcall(function()
for _,node in ipairs(Explorer.Selection.List) do
local obj = node.Obj
if obj and obj:IsA(prop.Class) then
local old
if prop.IsAttribute then old = obj:GetAttribute(prop.AttributeName) else old = obj[prop.Name] end
items[#items+1] = {obj = obj, old = old}
end
end
end)
local r = origSet(prop, val, noupdate, prevAttribute)
if #items > 0 then
local changed = false
for _,it in ipairs(items) do
pcall(function()
if prop.IsAttribute then it.new = it.obj:GetAttribute(prop.AttributeName) else it.new = it.obj[prop.Name] end
end)
if it.old ~= it.new then changed = true end
end
if changed then
local pname = prop.IsAttribute and prop.AttributeName or prop.Name
local function apply(useNew)
for _,it in ipairs(items) do
pcall(function()
local v
if useNew then v = it.new else v = it.old end
if prop.IsAttribute then it.obj:SetAttribute(prop.AttributeName, v) else it.obj[prop.Name] = v end
end)
end
pcall(Properties.ShowExplorerProps)
end
Explorer.PushHistory({
label = "Set " .. tostring(pname),
undo = function() apply(false) end,
redo = function() apply(true) end,
})
end
end
return r
end
Properties._historyWrapped = true
end
end
Explorer.InitKeybinds = function()
local UIS = service.UserInputService
local context = Explorer.RightClickContext
local heldKey
local function mouseOverExplorer()
local win = Explorer.Window
return win and win:IsVisible() and not win.Minimized and Lib.CheckMouseInGui(win.GuiElems.Main)
end
local function trigger(key)
local item = context.Registered[key]
if item and item.OnClick then item.OnClick(item.Name) end
end
local function move(dir)
local list = selection.List
local cur = selection.Piviot or list[#list]
if not cur then
if tree[1] then
selection:Set(tree[1])
selection.Piviot = tree[1]
Explorer.ViewNode(tree[1])
end
return
end
local idx = table.find(tree, cur)
if not idx then return end
local target
if dir == "Up" then
target = tree[idx-1]
elseif dir == "Down" then
target = tree[idx+1]
elseif dir == "Left" then
if #cur > 0 and expanded[cur] and expanded[cur] ~= 0 then
expanded[cur] = nil
Explorer.Update()
Explorer.Refresh()
return
end
target = cur.Parent
if target and not table.find(tree, target) then target = nil end
elseif dir == "Right" then
if #cur > 0 and not expanded[cur] and expanded[cur] ~= 0 then
expanded[cur] = true
Explorer.Update()
Explorer.Refresh()
return
end
if #cur > 0 and expanded[cur] then target = tree[idx+1] end
end
if target then
selection.ShiftSet = {}
selection:Set(target)
selection.Piviot = target
Explorer.ViewNode(target)
end
end
Explorer.KeyCon = UIS.InputBegan:Connect(function(input, gp)
if gp or input.UserInputType ~= Enum.UserInputType.Keyboard then return end
if not mouseOverExplorer() then return end
local kc = input.KeyCode
local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)
local shift = UIS:IsKeyDown(Enum.KeyCode.LeftShift) or UIS:IsKeyDown(Enum.KeyCode.RightShift)
local sList = selection.List
if ctrl then
if kc == Enum.KeyCode.Z then
if shift then Explorer.Redo() else Explorer.Undo() end
elseif kc == Enum.KeyCode.Y then
Explorer.Redo()
elseif kc == Enum.KeyCode.C then
if #sList > 0 then trigger("COPY") end
elseif kc == Enum.KeyCode.X then
if #sList > 0 then trigger("CUT") end
elseif kc == Enum.KeyCode.V then
if #clipboard > 0 and #sList > 0 then trigger("PASTE") end
elseif kc == Enum.KeyCode.D then
if #sList > 0 then trigger("DUPLICATE") end
elseif kc == Enum.KeyCode.G then
if #sList > 0 then trigger("GROUP") end
elseif kc == Enum.KeyCode.U then
if #sList > 0 then trigger("UNGROUP") end
elseif kc == Enum.KeyCode.A then
if #tree > 2000 then
hNotify("Too many rows to select all (" .. #tree .. ")")
else
local all = {}
for i = 1,#tree do
if tree[i] ~= nilNode then all[#all+1] = tree[i] end
end
selection:SetTable(all)
end
elseif kc == Enum.KeyCode.P then
if #sList > 0 and env.setclipboard then trigger("COPY_PATH") end
elseif kc == Enum.KeyCode.F then
local sb = Explorer.GuiElems.SearchBar
if sb then task.defer(function() sb:CaptureFocus() end) end
end
return
end
if kc == Enum.KeyCode.Delete then
if #sList == 0 then return end
for _,n in ipairs(sList) do
if n.Obj and isProtected(n.Obj) then
hNotify("Won't delete services / players with a key press")
return
end
end
trigger(shift and "DELETE_CHILDREN" or "DELETE")
elseif kc == Enum.KeyCode.F2 then
if #sList == 1 then trigger("RENAME") end
else
local dir
if kc == Enum.KeyCode.Up then dir = "Up"
elseif kc == Enum.KeyCode.Down then dir = "Down"
elseif kc == Enum.KeyCode.Left then dir = "Left"
elseif kc == Enum.KeyCode.Right then dir = "Right" end
if dir then
heldKey = kc
move(dir)
task.spawn(function()
local t0 = tick()
while heldKey == kc and UIS:IsKeyDown(kc) do
task.wait(0.03)
if tick() - t0 > 0.35 then move(dir) end
end
end)
end
end
end)
end
