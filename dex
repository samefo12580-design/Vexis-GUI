    callback = function(...)
        userCallback(...)
        if flag and selfTab.Window then selfTab.Window:_AutoSave() end
    end
    local currentKey = defaultKey or Enum.KeyCode.Unknown
    local listening = false

    local Card = create("Frame", {Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = Theme.CardHover, BackgroundTransparency = 0.3, Parent = self.CardSection}, {corner(6), stroke()})
    create("TextLabel", {
