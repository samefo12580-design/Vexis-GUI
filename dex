local function serialize(val)
local t = typeof(val)
if t == "Color3" then
return {R = val.R, G = val.G, B = val.B, __t = "Color3"}
elseif t == "Vector3" then
return {X = val.X, Y = val.Y, Z = val.Z, __t = "Vector3"}
elseif t == "number" then
if val ~= val then return 0 end
if val == math.huge then return "__inf" end
if val == -math.huge then return "__-inf" end
return val
elseif t == "string" or t == "boolean" or t == "table" then
return val
end
return nil
end
local function deserialize(val)
if type(val) == "string" then
if val == "__inf" then return math.huge end
if val == "__-inf" then return -math.huge end
elseif type(val) == "table" then
if val.__t == "Vector3" then return Vector3.new(val.X, val.Y, val.Z) end
if val.__t == "Color3" or (val.R and val.G and val.B) then
return Color3.new(val.R, val.G, val.B)
end
end
return val
end
