local function mdToRich(text)
text = tostring(text or "")
local inl = {}
text = text:gsub("`([^`\n]+)`", function(c) inl[#inl + 1] = c return "\1" .. #inl .. "\2" end)
text = xmlEscape(text)
local lines = {}
for line in (text .. "\n"):gmatch("(.-)\n") do
local h = line:match("^#+%s+(.*)$")
if h then line = "<b>" .. h .. "</b>"
else line = line:gsub("^(%s*)[%-%*]%s+", "%1\226\128\162 ") end
lines[#lines + 1] = line
end
text = table.concat(lines, "\n")
text = text:gsub("%*%*(.-)%*%*", "<b>%1</b>")
text = text:gsub("%*([^%*\n]+)%*", "<i>%1</i>")
text = text:gsub("\1(%d+)\2", function(i)
return '<font face="RobotoMono" color="' .. codeColorStr() .. '">' .. xmlEscape(inl[tonumber(i)] or "") .. '</font>'
end)
return text
end
local function parseSegments(text)
local segs, pos = {}, 1
while true do
local s, e, lang, code = text:find("```([%w_%-]*)\n?(.-)```", pos)
if not s then break end
if s > pos then segs[#segs + 1] = {t = "text", v = text:sub(pos, s - 1)} end
segs[#segs + 1] = {t = "code", v = code, lang = lang}
pos = e + 1
end
if pos <= #text then segs[#segs + 1] = {t = "text", v = text:sub(pos)} end
return segs
end
