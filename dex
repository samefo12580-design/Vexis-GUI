local history = {undo = {}, redo = {}, Busy = false}
Explorer.History = history
local HISTORY_LIMIT = 50
local CLONE_BUDGET = 4000
local function hNotify(text)
pcall(function() Main.Vortex.Notify("History", text, 2) end)
end
Explorer.PushHistory = function(action)
if history.Busy or not action then return end
table.insert(history.undo, action)
if #history.undo > HISTORY_LIMIT then table.remove(history.undo, 1) end
table.clear(history.redo)
end
local function runHistory(fromList, toList, verb)
local action = table.remove(fromList)
if not action then hNotify("Nothing to " .. verb:lower()) return end
history.Busy = true
local fn = (verb == "Undo") and action.undo or action.redo
local ok, err = pcall(fn)
history.Busy = false
if not ok then
warn("[Dex] " .. verb .. " failed: " .. tostring(err))
hNotify(verb .. " failed")
return
end
table.insert(toList, action)
hNotify(verb .. ": " .. action.label)
end
Explorer.Undo = function() runHistory(history.undo, history.redo, "Undo") end
Explorer.Redo = function() runHistory(history.redo, history.undo, "Redo") end
Explorer.CreatedAction = function(created, label)
return {
label = label .. (#created > 1 and (" x" .. #created) or ""),
undo = function()
for _,e in ipairs(created) do
pcall(function()
e.parent = e.obj.Parent or e.parent
e.snap = e.obj:Clone()
e.obj:Destroy()
end)
end
selection:Clear()
end,
redo = function()
for _,e in ipairs(created) do
pcall(function()
if e.snap then
e.obj = e.snap:Clone()
e.obj.Parent = e.parent
end
end)
end
end,
}
end
local function isProtected(obj)
return obj == game or obj.Parent == game or obj:IsA("Player")
end
local function selectedObjs()
local t = {}
for _,n in ipairs(selection.List) do
if n.Obj then t[#t+1] = n.Obj end
end
return t
end
local function snapshot(objs)
local entries, budget = {}, CLONE_BUDGET
for i = 1,#objs do
local obj = objs[i]
if not isProtected(obj) then
local okN, count = pcall(function() return #obj:GetDescendants() end)
budget = budget - (okN and count or 0) - 1
if budget < 0 then return nil end
local okC, c = pcall(game.Clone, obj)
if okC and c then
entries[#entries+1] = {obj = obj, clone = c, parent = obj.Parent}
end
end
end
return entries
end
local function restoreEntries(entries)
local restored = {}
for _,e in ipairs(entries) do
pcall(function()
local r = e.clone:Clone()
r.Parent = e.parent
e.current = r
restored[#restored+1] = r
end)
end
task.defer(function()
local sel = {}
for _,r in ipairs(restored) do
if nodes[r] then sel[#sel+1] = nodes[r] end
end
if #sel > 0 then
selection:SetTable(sel)
Explorer.ViewNode(sel[1])
end
end)
end
local function destroyEntries(entries)
for _,e in ipairs(entries) do
if e.current then
pcall(game.Destroy, e.current)
e.current = nil
end
end
selection:Clear()
end
local function wrap(key, prepare)
local item = Explorer.RightClickContext.Registered[key]
if not item or type(item.OnClick) ~= "function" then return end
local orig = item.OnClick
item.OnClick = function(...)
if history.Busy then return orig(...) end
local okP, finalize = pcall(prepare)
orig(...)
if okP and finalize then
local okF, err = pcall(finalize)
if not okF then warn("[Dex] history: " .. tostring(err)) end
end
end
end
