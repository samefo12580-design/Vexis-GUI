            local value = default or min
            local dragging = false

            local SliderFrame = Instance.new("Frame")
            SliderFrame.Size = UDim2.new(1, 0, 0, 26)
            SliderFrame.BackgroundTransparency = 1
            SliderFrame.ZIndex = 18
            SliderFrame.Parent = CardSection

            local Label = Instance.new("TextLabel")
            Label.Size = UDim2.new(0.4, 0, 1, 0)
            Label.Text = text
            Label.Font = Enum.Font.Gotham
            Label.TextSize = 12
            Label.TextColor3 = Library.Theme.TextPrimary
            Label.TextXAlignment = Enum.TextXAlignment.Left
            Label.BackgroundTransparency = 1
            Label.ZIndex = 19
            Label.Parent = SliderFrame

            local ValueBox = Instance.new("Frame")
            ValueBox.Size = UDim2.new(0, 42, 0, 22)
            ValueBox.Position = UDim2.new(1, -42, 0.5, -11)
            ValueBox.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
            ValueBox.BackgroundTransparency = 0.3
            ValueBox.ZIndex = 19
            ValueBox.Parent = SliderFrame
            Instance.new("UICorner", ValueBox).CornerRadius = UDim.new(0, 4)

            local ValueLabel = Instance.new("TextLabel")
            ValueLabel.Size = UDim2.new(1, 0, 1, 0)
            ValueLabel.Text = tostring(value) .. unit
            ValueLabel.Font = Enum.Font.Gotham
            ValueLabel.TextSize = 11
            ValueLabel.TextColor3 = Library.Theme.TextPrimary
            ValueLabel.BackgroundTransparency = 1
            ValueLabel.ZIndex = 20
            ValueLabel.Parent = ValueBox

            local Track = Instance.new("Frame")
            Track.Size = UDim2.new(0.6, -95, 0, 4)
            Track.Position = UDim2.new(0.4, 10, 0.5, -2)
            Track.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
            Track.BackgroundTransparency = 0.3
            Track.ZIndex = 19
            Track.Parent = SliderFrame
            Instance.new("UICorner", Track).CornerRadius = UDim.new(1, 0)

            local Fill = Instance.new("Frame")
            Fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
            Fill.BackgroundColor3 = Library.Theme.Accent
            Fill.ZIndex = 20
            Fill.Parent = Track
            Instance.new("UICorner", Fill).CornerRadius = UDim.new(1, 0)

            local Knob = Instance.new("Frame")
            Knob.Size = UDim2.new(0, 10, 0, 10)
            Knob.Position = UDim2.new(1, -5, 0.5, -5)
            Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            Knob.ZIndex = 21
            Knob.Parent = Fill
            Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

            local function update(input)
                local pos = math.clamp((input.Position.X - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
                value = math.floor(min + (max - min) * pos)
                Fill.Size = UDim2.new(pos, 0, 1, 0)
                ValueLabel.Text = tostring(value) .. unit
                if callback then callback(value) end
            end

            Track.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                    update(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    update(input)
                end
            end)
        end

        return Tab
    end

    return Window
end

return Library
