        function Tab:CreateInput(text, placeholder, callback, flag)
            local val = ""
            local f = Instance.new("Frame")
            f.Size = UDim2.new(1, 0, 0, 32)
            f.BackgroundTransparency = 1
            f.Parent = CardSection

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.5, 0, 1, 0)
            lbl.Text = text
            lbl.Font = Enum.Font.Gotham
            lbl.TextSize = 12
            lbl.TextColor3 = activeThemeData.TextPrimary
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.BackgroundTransparency = 1
            lbl.Parent = f

            local box = Instance.new("TextBox")
            box.Size = UDim2.new(0.5, 0, 1, 0)
            box.Position = UDim2.new(0.5, 0, 0, 0)
            box.BackgroundColor3 = Color3.fromRGB(32, 32, 32)
            box.PlaceholderText = placeholder or ""
            box.Text = ""
            box.Font = Enum.Font.Gotham
            box.TextSize = 11
            box.TextColor3 = activeThemeData.TextPrimary
            box.Parent = f
            Instance.new("UICorner", box).CornerRadius = UDim.new(0, 6)

            box.FocusLost:Connect(function()
                val = box.Text
                if flag then Library.Flags[flag] = val end
                if callback then pcall(callback, val) end
            end)

            return {
                Set = function(_, v) val = v box.Text = v if flag then Library.Flags[flag] = v end end,
                Get = function() return val end
            }
        end

        function Tab:CreateThemePicker(text)
            local themesList = {"blue", "violet", "emerald", "sunset", "amber"}
            return Tab:CreateDropdown(text, themesList, "blue", function(v)
                Window:SetTheme(v)
            end)
        end

        return Tab
    end

    return Window
end

return Library
