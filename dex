local function clean(v, trunc, depth)
local t = type(v)
if t == "string" then
if trunc and #v > 6000 then
local cut = v:sub(1, 6000)
while #cut > 0 and not utf8.len(cut) do cut = cut:sub(1, -2) end
return cut .. "\226\128\166[\224\184\149\224\184\177\224\184\148\224\185\131\224\184\171\224\185\137\224\184\170\224\184\177\224\185\137\224\184\153]"
end
return v
elseif t == "number" then
if v ~= v or v == math.huge or v == -math.huge then return 0 end
return v
elseif t == "boolean" then
return v
elseif t == "table" then
if depth > 14 then return nil end
local out, n, isArr = {}, 0, true
for k in pairs(v) do
n += 1
if type(k) ~= "number" then isArr = false end
end
if isArr and n == #v then
for i = 1, n do
local x = clean(v[i], trunc, depth + 1)
if x ~= nil then out[#out + 1] = x end
end
else
for k, x in pairs(v) do
local c = clean(x, trunc or k == "functionResponse", depth + 1)
if c ~= nil then out[tostring(k)] = c end
end
end
return out
end
return tostring(v)
end
