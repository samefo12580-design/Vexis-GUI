        Library.Themes                        -- ตาราง preset สีทั้งหมด (blue/violet/emerald/sunset/amber)
        Window:SetTheme("emerald")             -- สลับธีมแบบ live ทั้งหน้าต่าง มีอนิเมชันเปลี่ยนสี
        Tab:CreateThemePicker("เลือกธีม")       -- Dropdown สำเร็จรูปให้ผู้เล่นสลับธีมเองในเกม

    ฟังก์ชันที่มีให้ทั้งหมดใน Tab (ครบถ้วนจากอันเก่า 100%):
        Tab:CreateLabel(text)
        Tab:CreateGroupbox(title)
        Tab:CreateSection(text)
        Tab:CreateParagraph(title, content)
        Tab:CreateText(text)
        Tab:CreateButton(text, callback)
        Tab:CreateToggle(text, default, callback, flag)
        Tab:CreateSlider(text, min, max, default, callback, flag)
        Tab:CreateDropdown(text, options, default, callback, flag)
        Tab:CreateMultiDropdown(text, options, defaults, callback, flag)
        Tab:CreateInput(text, placeholder, callback, flag)
        Tab:CreateKeybind(text, defaultKey, callback, flag)
        Tab:CreateColorPicker(text, defaultColor, callback, flag)
        Tab:CreateThemePicker(text)
        Tab:CreateToggleMenuKeybind(text)
        Tab:CreateCFrameCopier(text)

    ฟังก์ชันของ Library / Window:
        Library:Notify(title, text, duration)
        Library:AddTooltip(guiObject, text)
        Library:GetCharacterCFrame()
        Library:GetCharacterCFrameString()
        Library:CopyCharacterCFrame()
        Window:SaveConfig()
        Window:LoadConfig()
        Window:SetTheme(themeKey)
        Window:Destroy()
]]

