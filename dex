function Library:Notify(title, text, duration)
    duration = duration or 3
    if not NotifHolder then return end

    local Card = create("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = Theme.Card,
        BackgroundTransparency = 0.2,
        Parent = NotifHolder,
        ClipsDescendants = true,
    }, {corner(8), stroke()})

    create("UIPadding", {
        PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12),
        Parent = Card,
    })

    create("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}).Parent = Card

    create("TextLabel", {
        Text = title or "แจ้งเตือน",
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Theme.Text,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Card,
    })

    create("TextLabel", {
        Text = text or "",
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = Theme.SubText,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = Card,
    })

    tween(Card, {BackgroundTransparency = 0}, 0.2):Play()

    task.delay(duration, function()
        tween(Card, {BackgroundTransparency = 1}, 0.3):Play()
        task.wait(0.3)
        Card:Destroy()
    end)
end

function Library:AddTooltip(guiObject, text)
    if not guiObject or not TooltipFrame then return end
    guiObject.MouseEnter:Connect(function()
        TooltipLabel.Text = text
        TooltipFrame.Visible = true
    end)
    guiObject.MouseLeave:Connect(function()
        TooltipFrame.Visible = false
    end)
    guiObject.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            TooltipFrame.Position = UDim2.new(0, input.Position.X + 16, 0, input.Position.Y + 16)
        end
    end)
end

function Library:GetCharacterCFrame()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    return hrp and hrp.CFrame or nil
end

function Library:GetCharacterCFrameString()
    local cf = self:GetCharacterCFrame()
    if not cf then return nil end
    local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
    return string.format(
        "CFrame.new(%.3f, %.3f, %.3f, %.5f, %.5f, %.5f, %.5f, %.5f, %.5f, %.5f, %.5f, %.5f)",
        x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22
    )
end

function Library:CopyCharacterCFrame()
    local cfStr = self:GetCharacterCFrameString()
    if not cfStr then
        self:Notify("CFrame", "ไม่พบตัวละครในตอนนี้", 3)
        return false, nil
    end
    local copied = setclipboard and pcall(function() setclipboard(cfStr) end)
    if copied then
        self:Notify("CFrame", "คัดลอกตำแหน่งลงคลิปบอร์ดแล้ว", 2)
    else
        self:Notify("CFrame", "Executor ไม่รองรับ setclipboard: " .. cfStr, 5)
    end
    return copied or false, cfStr
end

