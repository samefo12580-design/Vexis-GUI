function TabMT:CreateKeybind(text, defaultKey, callback, flag)
    local userCallback = callback or function() end
    local selfTab = self
    callback = function(...)
        userCallback(...)
        if flag and selfTab.Window then selfTab.Window:_AutoSave() end
    end
    local currentKey = defaultKey or Enum.KeyCode.Unknown
    local listening = false

    local Card = create("Frame", {
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Card, Parent = self.Page
    }, {corner(8), stroke()})

    create("TextLabel", {
        Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Text,
        BackgroundTransparency = 1, Size = UDim2.new(1, -100, 1, 0), Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left, Parent = Card,
    })

    local KeyBtn = create("TextButton", {
        Text = currentKey.Name, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.SubText,
        BackgroundColor3 = Theme.Sidebar, Size = UDim2.new(0, 80, 0, 24), Position = UDim2.new(1, -92, 0.5, -12),
        Parent = Card,
    }, {corner(6), stroke(Theme.Stroke, 1)})

    KeyBtn.MouseButton1Click:Connect(function()
        if listening then return end
        listening = true
        KeyBtn.Text = "..."
        tween(KeyBtn, {TextColor3 = Theme.Accent}, 0.15)
    end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not listening then
            if input.KeyCode == currentKey and not gameProcessed and currentKey ~= Enum.KeyCode.Unknown then
                callback(currentKey)
            end
            return
        end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            currentKey = input.KeyCode
            KeyBtn.Text = currentKey.Name
            listening = false
            tween(KeyBtn, {TextColor3 = Theme.SubText}, 0.15)
            callback(currentKey)
        end
    end)

    local Obj = {
        Set = function(_, key)
            if typeof(key) == "string" then key = Enum.KeyCode[key] end
            if not key then return end
            currentKey = key
            KeyBtn.Text = currentKey.Name
            userCallback(currentKey)
        end,
        Get = function() return currentKey.Name end,
        GetKeyCode = function() return currentKey end,
    }
    registerFlag(self, flag, Obj)
    return Obj
end

function TabMT:CreateColorPicker(text, defaultColor, callback, flag)
    local userCallback = callback or function() end
    local selfTab = self
    callback = function(...)
        userCallback(...)
        if flag and selfTab.Window then selfTab.Window:_AutoSave() end
    end
    local color = defaultColor or Color3.fromRGB(255, 255, 255)
    local open = false

    local Card = create("Frame", {
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Card,
        ClipsDescendants = true, Parent = self.Page,
    }, {corner(8), stroke()})

    create("TextLabel", {
        Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Text,
        BackgroundTransparency = 1, Size = UDim2.new(1, -60, 0, 38), Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left, Parent = Card,
    })

    local Preview = create("TextButton", {
        Text = "", BackgroundColor3 = color, Size = UDim2.new(0, 24, 0, 24),
        Position = UDim2.new(1, -36, 0, 7), Parent = Card,
    }, {corner(6), stroke()})

    local PickerHolder = create("Frame", {
        Size = UDim2.new(1, -16, 0, 90), Position = UDim2.new(0, 8, 0, 42),
        BackgroundTransparency = 1, Parent = Card,
    })

    local function makeChannelSlider(labelText, order, initValue, onChange)
        local Row = create("Frame", {
            Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0, (order - 1) * 26),
            BackgroundTransparency = 1, Parent = PickerHolder,
        })
        create("TextLabel", {
            Text = labelText, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = Theme.SubText,
            BackgroundTransparency = 1, Size = UDim2.new(0, 16, 1, 0), Parent = Row,
        })
        local Track = create("Frame", {
            Size = UDim2.new(1, -26, 0, 6), Position = UDim2.new(0, 20, 0.5, -3),
            BackgroundColor3 = Theme.Sidebar, Parent = Row,
        }, {corner(3)})
        local Fill = create("Frame", {Size = UDim2.new(initValue / 255, 0, 1, 0), BackgroundColor3 = Theme.Accent, Parent = Track}, {corner(3)})

        local dragging = false
        local function setFromX(xPos)
            local ratio = math.clamp((xPos - Track.AbsolutePosition.X) / Track.AbsoluteSize.X, 0, 1)
            Fill.Size = UDim2.new(ratio, 0, 1, 0)
            onChange(math.floor(ratio * 255))
        end
        Track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                setFromX(input.Position.X)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
        return Fill, Track
    end

    local r, g, b = math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255)
    local function updateColor()
        color = Color3.fromRGB(r, g, b)
        Preview.BackgroundColor3 = color
        callback(color)
    end
    makeChannelSlider("R", 1, r, function(v) r = v; updateColor() end)
    makeChannelSlider("G", 2, g, function(v) g = v; updateColor() end)
    makeChannelSlider("B", 3, b, function(v) b = v; updateColor() end)

    Preview.MouseButton1Click:Connect(function()
        open = not open
        tween(Card, {Size = UDim2.new(1, 0, 0, open and 138 or 38)}, 0.2)
    end)

    local Obj = {
        Set = function(_, newColor)
            if typeof(newColor) == "string" then newColor = Color3.fromHex(newColor) end
            color = newColor
            r, g, b = math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255)
            Preview.BackgroundColor3 = color
            callback(color)
        end,
        Get = function() return color:ToHex() end,
        GetColor3 = function() return color end,
    }
    registerFlag(self, flag, Obj)
    return Obj
end

function TabMT:CreateThemePicker(text)
    text = text or "ธีม"
    local keys, names = {}, {}
    for key, preset in pairs(ThemePresets) do
        table.insert(keys, key)
        names[preset.DisplayName or key] = key
    end
    table.sort(keys)

    local displayList = {}
    for _, key in ipairs(keys) do
        table.insert(displayList, ThemePresets[key].DisplayName or key)
    end

    local currentDisplay = ThemePresets[self.Window.CurrentTheme] and ThemePresets[self.Window.CurrentTheme].DisplayName or displayList[1]

    return self:CreateDropdown(text, displayList, currentDisplay, function(selectedName)
        local key = names[selectedName]
        if key then self.Window:SetTheme(key) end
    end)
end

function TabMT:CreateToggleMenuKeybind(text)
    text = text or "คีย์เปิด-ปิดเมนู"
    return self:CreateKeybind(text, self.Window.ToggleKey or Enum.KeyCode.RightControl, function(key)
        self.Window.ToggleKey = key
    end, "__ToggleMenuKey")
end

function TabMT:CreateCFrameCopier(text)
    text = text or "คัดลอกตำแหน่ง CFrame"

    local Card = create("Frame", {
        Size = UDim2.new(1, 0, 0, 38), BackgroundColor3 = Theme.Card,
        ClipsDescendants = true, Parent = self.Page,
    }, {corner(8), stroke()})

    create("TextLabel", {
        Text = text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = Theme.Text,
        BackgroundTransparency = 1, Size = UDim2.new(1, -92, 0, 38), Position = UDim2.new(0, 12, 0, 0),
        TextXAlignment = Enum.TextXAlignment.Left, Parent = Card,
    })

    local CopyBtn = create("TextButton", {
        Text = "คัดลอก", Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Theme.Text,
        BackgroundColor3 = Theme.Accent, Size = UDim2.new(0, 72, 0, 26), Position = UDim2.new(1, -80, 0, 6),
        Parent = Card,
    }, {corner(6)})

    local OutputBox = create("TextBox", {
        Text = "", Font = Enum.Font.Code, TextSize = 11, TextColor3 = Theme.SubText,
        ClearTextOnFocus = false, TextEditable = true, MultiLine = false,
        BackgroundColor3 = Theme.Sidebar, Size = UDim2.new(1, -16, 0, 26),
        Position = UDim2.new(0, 8, 0, 42), Visible = false, Parent = Card,
    }, {corner(6), stroke(Theme.Stroke, 1)})
    create("UIPadding", {PaddingLeft = UDim.new(0, 8)}).Parent = OutputBox

    CopyBtn.MouseButton1Click:Connect(function()
        local cfStr = Library:GetCharacterCFrameString()
        if not cfStr then
            Library:Notify("CFrame", "ไม่พบตัวละคร (Character)", 3)
            return
        end

        OutputBox.Text = cfStr
        OutputBox.Visible = true
        tween(Card, {Size = UDim2.new(1, 0, 0, 76)}, 0.2)

        local copied = Library:CopyCharacterCFrame()
        if not copied then
            OutputBox:CaptureFocus()
        end
    end)

    return {
        GetCFrameString = function() return Library:GetCharacterCFrameString() end,
    }
end

return Library
