            knob.Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.Parent = switch
            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            local click = Instance.new("TextButton")
            click.Size = UDim2.new(1, 0, 1, 0)
            click.BackgroundTransparency = 1
            click.Text = ""
            click.Parent = f

            local function update(val)
                state = val
                if flag then Library.Flags[flag] = state end
                tween(switch, {BackgroundColor3 = state and activeThemeData.Accent or Color3.fromRGB(45, 45, 45)})
                tween(knob, {Position = state and UDim2.new(1, -15, 0.5, -6) or UDim2.new(0, 3, 0.5, -6)})
                if callback then pcall(callback, state) end
            end

            click.MouseButton1Click:Connect(function() update(not state) end)

            return {
                Set = function(_, v) update(v) end,
                Get = function() return state end
            }
        end

        function Tab:CreateSlider(text, min, max, default, callback, flag)
