tools.get_script_source = {
description = "Source of a LocalScript/ModuleScript/Script via .Source or decompile(). Optional from_line/to_line to read a slice; large output is truncated to ~30k chars.",
parameters = {type = "object", properties = {path = {type = "string"}, from_line = {type = "integer"}, to_line = {type = "integer"}}, required = {"path"}},
run = function(args)
local inst, err = resolvePath(args.path)
if err then return {error = err} end
if not inst:IsA("LuaSourceContainer") then return {error = "not a script"} end
local src
local ok, s = pcall(function() return inst.Source end)
if ok and type(s) == "string" and s ~= "" then src = s end
if not src and env.decompile then
local ok2, out = pcall(env.decompile, inst)
if ok2 and type(out) == "string" then src = out end
end
if not src then return {error = "cannot read source (server script or no decompiler)"} end
local total = select(2, src:gsub("\n", "\n")) + 1
if args.from_line or args.to_line then
local a, b, i, buf = tonumber(args.from_line) or 1, tonumber(args.to_line) or total, 0, {}
for line in (src .. "\n"):gmatch("(.-)\n") do
i += 1
if i >= a and i <= b then buf[#buf + 1] = i .. ": " .. line end
if i > b then break end
end
src = table.concat(buf, "\n")
end
if #src > 30000 then src = src:sub(1, 30000) .. "\n-- [truncated]" end
return {path = getPath(inst), class = inst.ClassName, total_lines = total, source = src}
end
}
