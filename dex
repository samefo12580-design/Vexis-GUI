local DexLibrary = {}
function DexLibrary.GetKeys()
local genv = (getgenv and getgenv()) or _G
if type(genv.DarkDexKeys) ~= "table" then
local old = genv.DarkDexKeys
genv.DarkDexKeys = {}
if type(old) == "string" then
for k in old:gmatch("[^%s,;]+") do table.insert(genv.DarkDexKeys, k) end
end
end
return genv.DarkDexKeys
end
function DexLibrary.AddKey(key)
if type(key) ~= "string" then return false end
local list = DexLibrary.GetKeys()
for _, k in ipairs(list) do
if k == key then return false end
end
table.insert(list, key)
return true
end
function DexLibrary.SetKeys(keys)
local list = DexLibrary.GetKeys()
for i = #list, 1, -1 do list[i] = nil end
if type(keys) == "string" then keys = {keys} end
for _, k in ipairs(keys or {}) do DexLibrary.AddKey(k) end
end
return DexLibrary
