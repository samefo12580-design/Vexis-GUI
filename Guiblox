		self._win:SelectTab(self)
	end
end

function ContainerMT:Destroy()
	for i = #self._items, 1, -1 do
		local it = self._items[i]
		if it and it.Destroy then
			pcall(it.Destroy, it)
		end
	end
	self._items = {}
	if self._isTab then
		local win = self._win
		pcall(untrackTree, self._btn)
		pcall(function()
			self._btn:Destroy()
		end)
		pcall(function()
			self._page:Destroy()
		end)
		for i = #win.Tabs, 1, -1 do
			if win.Tabs[i] == self then
				table.remove(win.Tabs, i)
			end
		end
		if win._selected == self then
			win._selected = nil
			if win.Tabs[1] then
				win:SelectTab(win.Tabs[1])
			end
		end
	elseif self.Instance then
		local inst = self.Instance
		pcall(untrackTree, inst)
		pcall(function()
			inst:Destroy()
		end)
	end
end

function WindowMT:SelectTab(tab)
	if type(tab) == "string" then
		for i = 1, #self.Tabs do
			if self.Tabs[i].Name == tab then
				tab = self.Tabs[i]
				break
			end
		end
	end
	if type(tab) ~= "table" or tab._win ~= self then
		return
	end
	closeOpen()
	for i = 1, #self.Tabs do
		local t = self.Tabs[i]
		local on = t == tab
		t._page.Visible = on
		t._btn.BackgroundColor3 = on and C.Card or C.Side
		t._lbl.TextColor3 = on and C.Text or C.Sub
		t._ind.Visible = on
	end
	self._selected = tab
end

function WindowMT:CreateTab(name, icon)
	local window = self
	name = tostring(name or "Tab")
	local page = mk("ScrollingFrame", {
		Name = name,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2New(1, 0, 1, 0),
		CanvasSize = UDim2New(0, 0, 0, 0),
		AutomaticCanvasSize = AutoY,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = C.Sub,
		ScrollingDirection = DirY,
		Visible = false,
	})
	pad(page, 8, 8, 12, 8)
	stack(page, 6)
	page.Parent = window._contentArea
	local btn = mk("TextButton", {
		Name = name,
		BackgroundColor3 = C.Side,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		Size = UDim2New(1, 0, 0, 30),
		LayoutOrder = #window.Tabs + 1,
	})
	round(btn, 5)
	local lbl = label(btn, {
		Position = UDim2Offset(12, 0),
		Size = UDim2New(1, -18, 1, 0),
		Text = name,
		TextColor3 = C.Sub,
		TextTruncate = TruncEnd,
	})
	local ind = mk("Frame", {
		BorderSizePixel = 0,
		Position = UDim2New(0, 0, 0.5, -8),
		Size = UDim2Offset(3, 16),
		Visible = false,
	}, btn)
	round(ind, 2)
	track(ind, function()
		ind.BackgroundColor3 = Accent
	end)
	btn.Parent = window._tabHolder
	local tab = setmetatable({
		_content = page,
		_page = page,
		_btn = btn,
		_lbl = lbl,
		_ind = ind,
		_order = 0,
		_win = window,
		_items = {},
		_isTab = true,
		Name = name,
		Instance = page,
		Type = "Tab",
	}, ContainerMT)
	window.Tabs[#window.Tabs + 1] = tab
	btn.MouseButton1Click:Connect(function()
		window:SelectTab(tab)
	end)
	if #window.Tabs == 1 then
		window:SelectTab(tab)
	end
	return tab
end

function WindowMT:SetVisible(v)
