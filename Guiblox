	local obj = { Instance = f, Type = "TextBox", Default = "" }
	function obj:Get() return box.Text end
	function obj:Set(v, silent) box.Text = tostring(v or ""); emit(obj, silent) end
	function obj:Clear(silent) obj:Set("", silent) end
	function obj:Reset() obj:Set("") end
	box.FocusLost:Connect(function() emit(obj, false) end)
	mini("Clear", 44, -8, function() obj:Set("") end)
	mini("Copy", 42, -56, function()
		local ok = type(setclipboard) == "function" and pcall(setclipboard, box.Text)
		Library:Notify("Copy", ok and "Copied" or "setclipboard not supported", 2, ok and "success" or "warning")
	end)
	return register(obj, flag, callback)
end

function TabMT:CreateKeybind(t, defaultKey, callback, flag)
	local function toKey(k)
		if typeof(k) == "EnumItem" then return k end
		if type(k) == "string" then
			local ok, v = pcall(function() return Enum.KeyCode[k] end)
			if ok and v then return v end
		end
		return nil
	end
	local def = toKey(defaultKey) or Enum.KeyCode.Unknown
	local key = def
	local listening = false
	local changed = {}
	local f = card(self, 34)
	text(f, { Text = tostring(t or "Keybind"), Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -100, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
	local btn = mk("TextButton", {
		Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Library.Accent, Size = UDim2.fromOffset(80, 22), AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0), BackgroundColor3 = C.input, BorderSizePixel = 0, AutoButtonColor = false, Text = "",
	}, f)
	round(btn, 4)
	local function show() btn.Text = key == Enum.KeyCode.Unknown and "None" or key.Name end
	show()
	local obj = { Instance = f, Type = "Keybind", Default = def }
	function obj:Get() return key end
	function obj:GetKeyCode() return key end
	function obj:Set(k, silent)
		local kc = toKey(k)
		if not kc then return end
		key = kc
		show()
		if obj.Flag then Library.Flags[obj.Flag] = key end
		if not silent then for _, fn in ipairs(changed) do safe(fn, key) end end
	end
	function obj:Reset() obj:Set(obj.Default) end
	function obj:OnChanged(fn) changed[#changed + 1] = fn; return obj end
	btn.MouseButton1Click:Connect(function()
		if listening then return end
		listening = true
		Library._listening = true
		btn.Text = "..."
	end)
	keyHandlers[#keyHandlers + 1] = function(input, gpe)
		if listening then
			if input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				Library._listening = false
				if input.KeyCode ~= Enum.KeyCode.Escape then obj:Set(input.KeyCode) else show() end
			end
			return
		end
		if not gpe and key ~= Enum.KeyCode.Unknown and input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == key then
			safe(obj.Callback, key)
		end
	end
	return register(obj, flag, callback, true)
end

function TabMT:CreateColorPicker(t, defaultColor, callback, flag)
	local def = typeof(defaultColor) == "Color3" and defaultColor or C.white
	local color = def
	local open = false
	local f = card(self, 34)
	text(f, { Text = tostring(t or "Color"), Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -60, 0, 34), TextTruncate = Enum.TextTruncate.AtEnd })
	local preview = mk("TextButton", { Text = "", Size = UDim2.fromOffset(32, 20), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 7), AutoButtonColor = false, BorderSizePixel = 0 }, f)
	round(preview, 4)
	local panel = mk("Frame", { Position = UDim2.fromOffset(10, 40), Size = UDim2.new(1, -20, 0, 100), BackgroundTransparency = 1 }, f)
	local ch, fills = { R = 0, G = 0, B = 0 }, {}
	local hex
	local obj = { Instance = f, Type = "ColorPicker", Default = def }
	local function refresh()
		preview.BackgroundColor3 = color
		ch.R, ch.G, ch.B = math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
		for k, fl in pairs(fills) do fl.Size = UDim2.fromScale(ch[k] / 255, 1) end
		if hex then hex.Text = "#" .. toHex(color) end
	end
	local function setColor(c, silent)
		color = c
		refresh()
		emit(obj, silent)
	end
	local tints = { R = Color3.fromRGB(235, 80, 80), G = Color3.fromRGB(90, 205, 120), B = Color3.fromRGB(90, 140, 245) }
	for i, name in ipairs({ "R", "G", "B" }) do
		local row = mk("Frame", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, (i - 1) * 24), BackgroundTransparency = 1 }, panel)
		text(row, { Text = name, TextSize = 11, TextColor3 = C.sub, Size = UDim2.fromOffset(14, 20) })
		local tr = mk("Frame", { Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 20, 0.5, -3), BackgroundColor3 = C.input, BorderSizePixel = 0 }, row)
		round(tr, 3)
		local fl = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = tints[name], BorderSizePixel = 0 }, tr)
		round(fl, 3)
		fills[name] = fl
		local hit = mk("TextButton", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.5, -10), BackgroundTransparency = 1, Text = "" }, tr)
		local function fromInput(inp)
			ch[name] = math.floor(math.clamp((inp.Position.X - tr.AbsolutePosition.X) / math.max(tr.AbsoluteSize.X, 1), 0, 1) * 255 + 0.5)
			setColor(Color3.fromRGB(ch.R, ch.G, ch.B))
		end
		hit.InputBegan:Connect(function(inp) if isPress(inp) then fromInput(inp); startDrag(fromInput) end end)
	end
	hex = mk("TextBox", {
		Font = Enum.Font.Code, TextSize = 12, TextColor3 = C.text, ClearTextOnFocus = false, Text = "", Size = UDim2.new(1, 0, 0, 22),
		Position = UDim2.fromOffset(0, 76), BackgroundColor3 = C.input, BorderSizePixel = 0,
	}, panel)
	round(hex, 4)
	hex.FocusLost:Connect(function()
		local c = fromHex(hex.Text)
		if c then setColor(c) else refresh() end
	end)
	refresh()
	function obj:Get() return color end
	function obj:GetColor3() return color end
	function obj:Set(v, silent)
		local c = v
		if type(v) == "string" then c = fromHex(v) end
		if typeof(c) ~= "Color3" then return end
		setColor(c, silent)
	end
	function obj:Reset() obj:Set(obj.Default) end
	preview.MouseButton1Click:Connect(function()
		open = not open
		f.Size = UDim2.new(1, 0, 0, open and 148 or 34)
	end)
	return register(obj, flag, callback)
end

