function WindowMT:Minimize(state)
	if state == nil then
		state = not self._min
	end
	self._min = state and true or false
	closeOpen()
	self._body.Visible = not self._min
	if self._min then
		self._main.Size = UDim2Offset(self._w, TB)
	else
		self._main.Size = UDim2Offset(self._w, self._h)
	end
end

