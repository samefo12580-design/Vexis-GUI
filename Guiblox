		TextColor3 = C.Text,
		Font = FontMedium,
		TextSize = 12,
	}, card)
	round(btn, 4)
	outline(btn, C.Stroke, 1)
	local function resolve(k)
		if typeof(k) == "EnumItem" and k.EnumType == EnumKeyCode then
			return k
		end
		if type(k) == "string" then
			local ok, r = pcall(function()
				return EnumKeyCode[k]
			end)
			if ok and r then
				return r
			end
		end
		return nil
	end
	local obj = newObj()
	local changed = {}
	obj.Value = resolve(defaultKey) or KeyUnknown
	obj._callback = callback
	local initial = obj.Value
	local function show()
		if obj.Value == KeyUnknown then
			btn.Text = "None"
		else
			btn.Text = obj.Value.Name
		end
	end
	function obj:Get()
		return obj.Value
	end
	function obj:GetKeyCode()
		return obj.Value
	end
	function obj:Set(k, silent)
		obj.Value = resolve(k) or KeyUnknown
		show()
		if flag ~= nil then
			Library.Flags[flag] = obj.Value
		end
		if not silent then
			for i = 1, #changed do
				call(changed[i], obj.Value)
			end
		end
	end
	function obj:Reset()
		obj:Set(initial, false)
	end
	function obj:OnChanged(fn)
		changed[#changed + 1] = fn
		return obj
	end
	btn.MouseButton1Click:Connect(function()
		local prev = listening
		listening = nil
		if prev then
			pcall(prev, KeyEscape)
		end
		btn.Text = "..."
		listening = function(k)
			if k == KeyEscape then
				show()
			else
				obj:Set(k, false)
			end
		end
	end)
	keybinds[#keybinds + 1] = obj
	obj._cleanup = function()
		for i = #keybinds, 1, -1 do
			if keybinds[i] == obj then
				table.remove(keybinds, i)
			end
		end
	end
	show()
	if flag ~= nil then
		Library.Flags[flag] = obj.Value
	end
	return attach(self, obj, card, "Keybind", flag)
end

