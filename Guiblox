function TabMT:CreateLabel(text)
	local l = label(self.Page, {
		Text = tostring(text or ""), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
		TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = nextOrder(self),
	}, "SubText")
	return { Instance = l, SetText = function(_, s) l.Text = tostring(s) end }
end

function TabMT:CreateSection(text)
	local holder = new("Frame", { Size = UDim2.new(1, 0, 0, 28), BackgroundTransparency = 1, LayoutOrder = nextOrder(self), Parent = self.Page })
	local dash = new("Frame", { Size = UDim2.fromOffset(3, 12), Position = UDim2.fromOffset(0, 6), BorderSizePixel = 0, BackgroundColor3 = WHITE, Parent = holder })
	corner(dash, 2)
	gradient(dash, 90)
	label(holder, { Text = string.upper(tostring(text)), Font = Enum.Font.GothamBold, TextSize = 11, Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -10, 0, 24) }, "Accent")
	new("Frame", { Position = UDim2.new(0, 0, 1, -2), Size = UDim2.new(1, 0, 0, 1), BorderSizePixel = 0, Parent = holder }, { BackgroundColor3 = "Stroke" })
	return { Instance = holder }
