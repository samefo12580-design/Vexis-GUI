		})
		local bar = mk("Frame", {
			Position = UDim2New(0, 32, 0, y + 7),
			Size = UDim2New(1, -88, 0, 6),
			BackgroundColor3 = C.Off,
			BorderSizePixel = 0,
		}, card)
		round(bar, 3)
		fills[i] = mk("Frame", {
			BackgroundColor3 = chanColors[i],
			BorderSizePixel = 0,
			Size = UDim2New(0, 0, 1, 0),
		}, bar)
		round(fills[i], 3)
		nums[i] = label(card, {
			AnchorPoint = Vector2New(1, 0),
			Position = UDim2New(1, -10, 0, y),
