function TabMT:CreateButton(t, callback)
	local f = card(self, 32)
	local btn = mk("TextButton", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = tostring(t or "Button"), Font = Enum.Font.GothamMedium,
		TextSize = 13, TextColor3 = C.text, AutoButtonColor = false,
	}, f)
	btn.MouseEnter:Connect(function() f.BackgroundColor3 = C.hover end)
	btn.MouseLeave:Connect(function() f.BackgroundColor3 = C.card end)
	local obj = { Instance = f, Type = "Button" }
	function obj:Fire() safe(callback) end
	function obj:SetText(s) btn.Text = tostring(s) end
	btn.MouseButton1Click:Connect(function() obj:Fire() end)
