	local fills = {}
	local nums = {}
	local apply
	local function channels()
		return math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)
	end
	for i = 1, 3 do
		local y = 40 + (i - 1) * 26
		label(card, {
			Position = UDim2Offset(12, y),
