		label(logo, { Text = tostring(titleText):sub(1, 1):upper(), Font = Enum.Font.GothamBold, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1) }, "AccentText")
	end
