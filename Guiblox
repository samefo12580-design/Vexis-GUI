	end
	local function addBar(b, icons, w, h, rot)
		local f = new("Frame", { Size = UDim2.fromOffset(w, h), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Rotation = rot or 0, BorderSizePixel = 0, Parent = b }, { BackgroundColor3 = "SubText" })
		corner(f, 1)
		table.insert(icons, f)
		return f
	end
	local CloseBtn, ci = mkCtl(1, "Error")
	addBar(CloseBtn, ci, 12, 2, 45)
	addBar(CloseBtn, ci, 12, 2, -45)
	local MinBtn, mi = mkCtl(2, "CardHover")
	addBar(MinBtn, mi, 11, 2, 0)
	local MinPlus = addBar(MinBtn, mi, 2, 11, 0)
	MinPlus.Visible = false

	-- SIDEBAR
	local Sidebar = new("Frame", { Name = "Sidebar", Size = UDim2.new(0, SW, 1, -(TOP + 2)), Position = UDim2.fromOffset(0, TOP + 2), BorderSizePixel = 0, Parent = Main }, { BackgroundColor3 = "Sidebar" })
	new("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0), BorderSizePixel = 0, Parent = Sidebar }, { BackgroundColor3 = "Stroke" })
	label(Sidebar, { Text = "MENU", Font = Enum.Font.GothamBold, TextSize = 9, Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -20, 0, 12), Visible = not compact }, "SubText")
	local TabList = new("ScrollingFrame", {
		Size = UDim2.new(1, -12, 1, -(26 + 62)), Position = UDim2.fromOffset(6, 26), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Parent = Sidebar,
	})
	list(TabList, 4)
	Window.TabList = TabList

	-- โปรไฟล์ผู้เล่น (ล่างซ้าย)
	local Profile = new("Frame", { Size = UDim2.new(1, -12, 0, 46), Position = UDim2.new(0, 6, 1, -54), Parent = Sidebar }, { BackgroundColor3 = "Card" })
	corner(Profile, 10)
	stroke(Profile, "Stroke")
	local AvatarBg = new("Frame", { Size = UDim2.fromOffset(32, 32), Position = compact and UDim2.new(0.5, -16, 0.5, -16) or UDim2.new(0, 8, 0.5, -16), BorderSizePixel = 0, Parent = Profile }, { BackgroundColor3 = "Input" })
	corner(AvatarBg, 16)
	local Avatar = new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = AvatarBg })
	corner(Avatar, 16)
	local Dot = new("Frame", { Size = UDim2.fromOffset(9, 9), Position = UDim2.new(1, -9, 1, -9), BorderSizePixel = 0, Parent = AvatarBg }, { BackgroundColor3 = "Success" })
	corner(Dot, 5)
	stroke(Dot, "Card").Thickness = 2
	task.spawn(function()
		pcall(function()
			Avatar.Image = Players:GetUserThumbnailAsync(LocalPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
	end)
	label(Profile, { Text = LocalPlayer.DisplayName, Font = Enum.Font.GothamBold, TextSize = 11, Position = UDim2.fromOffset(48, 7), Size = UDim2.new(1, -54, 0, 15), TextTruncate = Enum.TextTruncate.AtEnd, Visible = not compact }, "Text")
	label(Profile, { Text = "@" .. LocalPlayer.Name, TextSize = 9, Position = UDim2.fromOffset(48, 22), Size = UDim2.new(1, -54, 0, 14), TextTruncate = Enum.TextTruncate.AtEnd, Visible = not compact }, "SubText")

	-- CONTENT
	local Content = new("Frame", { Name = "Content", Size = UDim2.new(1, -(SW + 1), 1, -(TOP + 2)), Position = UDim2.fromOffset(SW + 1, TOP + 2), BackgroundTransparency = 1, Parent = Main })
	pad(Content, 14, 10, 6, 6)
	Window.Header = label(Content, { Font = Enum.Font.GothamBold, TextSize = 17, Size = UDim2.new(1, 0, 0, 24) }, "Text")
	local hline = new("Frame", { Size = UDim2.fromOffset(28, 3), Position = UDim2.fromOffset(0, 27), BorderSizePixel = 0, BackgroundColor3 = WHITE, Parent = Content })
	corner(hline, 2)
	gradient(hline, 0)
	Window.Pages = new("Frame", { Position = UDim2.fromOffset(0, 38), Size = UDim2.new(1, 0, 1, -38), BackgroundTransparency = 1, ClipsDescendants = true, Parent = Content })

	-- Minimize / reset / close
	local isMin = false
	Window._minimized = false
	local function setMin(state)
		if isMin == state then return end
		isMin = state
		Window._minimized = state
		Sidebar.Visible, Content.Visible, accentLine.Visible = not state, not state, not state
		MinPlus.Visible = state
		Main.Size = state and UDim2.fromOffset(math.min(W, 300), TOP + 2) or UDim2.fromOffset(W, H)
		if Library._openDD and Library._openDD.open then Library._openDD.setOpen(false) end
	end
	Window._setMin = setMin
	Window._resetLayout = function()
		if isMin then setMin(false) end
		Main.Position = centerPos(W, H)
	end

	MinBtn.MouseButton1Click:Connect(function() setMin(not isMin) end)
	CloseBtn.MouseButton1Click:Connect(function()
		if closeAction == "Hide" then
			Window:SetVisible(false)
			if not Window._hinted then
				Window._hinted = true
				Library:Notify(titleText, "Hidden. Press " .. Window.ToggleKey.Name .. " to open it again", 4)
			end
		else
			Window:Destroy()
		end
	end)

	-- ลากหน้าต่าง
	DragArea.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		local sm, sp = input.Position, Main.Position
		startDrag(function(i)
			local d = i.Position - sm
			local v = viewport()
			local x = math.clamp(sp.X.Offset + d.X, -Main.AbsoluteSize.X + 80, v.X - 80)
			local y = math.clamp(sp.Y.Offset + d.Y, 0, v.Y - TOP)
			Main.Position = UDim2.fromOffset(x, y)
		end)
	end)

	-- ปุ่มคีย์บอร์ดเปิด/ปิด
	conn(UserInputService.InputBegan, function(input, gpe)
		if gpe or Library._listening then return end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Window.ToggleKey then Window:Toggle() end
	end)

	-- ปุ่มลอยสำหรับมือถือ (แตะ = เปิด/ปิด, ลาก = ย้าย)
	if config.MobileButton ~= false and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local FS = 40
		local fab = new("TextButton", {
			Size = UDim2.fromOffset(FS, FS), Position = UDim2.fromOffset(10, math.floor(vp.Y / 2)), Text = "UI",
			Font = Enum.Font.GothamBold, TextSize = 12, AutoButtonColor = false, ZIndex = 60, Parent = ScreenGui,
		}, { BackgroundColor3 = "Sidebar", TextColor3 = "Accent" })
		corner(fab, FS / 2)
		stroke(fab, "Accent")
		fab.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			local startIn, startPos, moved = input.Position, fab.AbsolutePosition, false
			startDrag(function(i)
				local d = i.Position - startIn
				if not moved and d.Magnitude < 8 then return end
				moved = true
				local v = viewport()
				fab.Position = UDim2.fromOffset(math.clamp(startPos.X + d.X, 4, v.X - FS - 4), math.clamp(startPos.Y + d.Y, 4, v.Y - FS - 4))
			end, function()
				if not moved then Window:Toggle() end
			end)
		end)
	end

	if config.Settings ~= false then Window:_buildSettings() end
	task.defer(function()
		if not Window.ActiveTab and Window.Tabs[1] then Window:SelectTab(Window.Tabs[1]) end
	end)

	return Window
end

-- ถ้าเคยรันสคริปต์นี้มาก่อน ให้ปิดตัวเก่าก่อน
local env = (type(getgenv) == "function" and getgenv()) or _G
if env.__VortexLibrary and env.__VortexLibrary ~= Library then
	pcall(function() env.__VortexLibrary:Unload() end)
end
env.__VortexLibrary = Library

return Library
