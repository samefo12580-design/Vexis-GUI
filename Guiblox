		if typeof(c3) == "Color3" then
			apply(c3, silent)
		end
	end
	function obj:Reset()
		apply(initial, false)
	end
	attach(self, obj, card, "ColorPicker", flag)
	if Library.FireOnInit then
		taskDefer(call, callback, color)
	end
	return obj
end

function ContainerMT:CreateKeybind(text, defaultKey, callback, flag)
