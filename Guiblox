local function paintTab(t, active)
	t.Button.BackgroundTransparency = active and 0 or 1
	t.Indicator.Visible = active
	setBind(t.Label, "TextColor3", active and "Text" or "SubText")
	setBind(t.Badge, "BackgroundColor3", active and "Accent" or "Input")
	if t.IconObj then setBind(t.IconObj, "ImageColor3", active and "AccentText" or "SubText") end
	if t.BadgeLbl then setBind(t.BadgeLbl, "TextColor3", active and "AccentText" or "SubText") end
end

function WindowMT:SelectTab(tab)
	if self.ActiveTab == tab then return end
	if Library._openDD and Library._openDD.open then Library._openDD.setOpen(false) end
	for _, t in ipairs(self.Tabs) do
		t.MainPage.Visible = false
		paintTab(t, false)
	end
	tab.MainPage.Visible = true
	paintTab(tab, true)
	self.Header.Text = tab.Name
	self.ActiveTab = tab
end

