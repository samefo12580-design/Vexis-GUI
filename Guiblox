function WindowMT:Destroy()
	if self._dead then
		return
	end
	self._dead = true
	closeOpen()
	for i = #self._items, 1, -1 do
		local it = self._items[i]
		if it and it.Destroy then
			pcall(it.Destroy, it)
		end
	end
	self._items = {}
	for i = #Library.Windows, 1, -1 do
		if Library.Windows[i] == self then
			table.remove(Library.Windows, i)
		end
	end
	pcall(untrackTree, self._main)
	pcall(function()
		self._main:Destroy()
	end)
	if self._mobile then
		pcall(untrackTree, self._mobile)
		pcall(function()
			self._mobile:Destroy()
		end)
	end
end

function Library:CreateWindow(config)
	if type(config) == "string" then
		config = { Title = config }
	elseif type(config) ~= "table" then
		config = {}
	end
	if config.FireOnInit ~= nil then
		Library.FireOnInit = config.FireOnInit and true or false
	end
	if typeof(config.Accent) == "Color3" then
		Library:SetAccent(config.Accent)
	end
	local gui = getRoot()
	local title = tostring(config.Title or config[1] or "Vortex UI")
	local subtitle = config.Subtitle ~= nil and tostring(config.Subtitle) or ""
	local closeAction = config.CloseAction == "Hide" and "Hide" or "Destroy"
	local toggleKey = config.ToggleKey
	if typeof(toggleKey) ~= "EnumItem" then
		toggleKey = KeyDefaultToggle
	end
	local vp = viewport()
	local w, h = 540, 380
	if typeof(config.Size) == "UDim2" then
		local s = config.Size
		local sw = s.X.Offset + s.X.Scale * vp.X
		local sh = s.Y.Offset + s.Y.Scale * vp.Y
		if sw > 0 then
			w = sw
		end
		if sh > 0 then
			h = sh
		end
	end
	w = math.floor(math.max(260, math.min(w, vp.X - 16)))
	h = math.floor(math.max(200, math.min(h, vp.Y - 16)))
	local sideW = 130
	if w < 440 then
		sideW = 100
	end
	local main = mk("Frame", {
		Name = "Window",
		BackgroundColor3 = C.Bg,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2Offset(math.floor((vp.X - w) / 2), math.floor((vp.Y - h) / 2)),
		Size = UDim2Offset(w, h),
	})
	round(main, 8)
	outline(main, C.Stroke, 1)
	local bar = mk("Frame", {
		Name = "TitleBar",
		BackgroundColor3 = C.Side,
		BorderSizePixel = 0,
		Size = UDim2New(1, 0, 0, TB),
	}, main)
	round(bar, 8)
	mk("Frame", {
		BackgroundColor3 = C.Side,
		BorderSizePixel = 0,
		Position = UDim2New(0, 0, 1, -8),
		Size = UDim2New(1, 0, 0, 8),
	}, bar)
	local line = mk("Frame", {
		BorderSizePixel = 0,
		Position = UDim2New(0, 0, 1, -1),
		Size = UDim2New(1, 0, 0, 1),
	}, bar)
	track(line, function()
		line.BackgroundColor3 = Accent
	end)
	local info = mk("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2Offset(12, 0),
		Size = UDim2New(1, -84, 1, 0),
	}, bar)
	mk("UIListLayout", {
		FillDirection = FillHorizontal,
		Padding = UDimNew(0, 8),
		SortOrder = SortLayout,
		VerticalAlignment = VAlignCenter,
	}, info)
	local titleLabel = label(info, {
		AutomaticSize = AutoX,
		Size = UDim2New(0, 0, 1, 0),
		Text = title,
		Font = FontBold,
		TextSize = 14,
		LayoutOrder = 1,
	})
	local subLabel = label(info, {
		AutomaticSize = AutoX,
		Size = UDim2New(0, 0, 1, 0),
		Text = subtitle,
		TextSize = 11,
		TextColor3 = C.Sub,
		LayoutOrder = 2,
	})
	local function barButton(txt, x)
		local b = mk("TextButton", {
			AnchorPoint = Vector2New(1, 0.5),
			Position = UDim2New(1, x, 0.5, 0),
			Size = UDim2Offset(28, 22),
			BackgroundColor3 = C.Side,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Text = txt,
			Font = FontBold,
			TextSize = 14,
			TextColor3 = C.Sub,
		}, bar)
		round(b, 5)
		return b
	end
	local minBtn = barButton("-", -42)
	local closeBtn = barButton("x", -10)
	minBtn.MouseEnter:Connect(function()
		minBtn.BackgroundColor3 = C.Hover
		minBtn.TextColor3 = C.Text
	end)
	minBtn.MouseLeave:Connect(function()
		minBtn.BackgroundColor3 = C.Side
		minBtn.TextColor3 = C.Sub
	end)
	closeBtn.MouseEnter:Connect(function()
		closeBtn.BackgroundColor3 = C.Hover
		closeBtn.TextColor3 = C.Err
	end)
	closeBtn.MouseLeave:Connect(function()
		closeBtn.BackgroundColor3 = C.Side
		closeBtn.TextColor3 = C.Sub
	end)
	local body = mk("Frame", {
		Name = "Body",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Position = UDim2Offset(0, TB),
		Size = UDim2New(1, 0, 1, -TB),
	}, main)
	local side = mk("Frame", {
		Name = "Sidebar",
		BackgroundColor3 = C.Side,
		BorderSizePixel = 0,
		Size = UDim2New(0, sideW, 1, 0),
	}, body)
	round(side, 8)
	mk("Frame", {
		BackgroundColor3 = C.Side,
		BorderSizePixel = 0,
		Size = UDim2New(1, 0, 0, 8),
	}, side)
	mk("Frame", {
		BackgroundColor3 = C.Side,
		BorderSizePixel = 0,
		Position = UDim2New(1, -8, 0, 0),
		Size = UDim2New(0, 8, 1, 0),
	}, side)
	local tabHolder = mk("ScrollingFrame", {
		Name = "Tabs",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2New(1, 0, 1, 0),
		CanvasSize = UDim2New(0, 0, 0, 0),
		AutomaticCanvasSize = AutoY,
		ScrollBarThickness = 0,
		ScrollingDirection = DirY,
	}, side)
	pad(tabHolder, 6, 8, 6, 8)
	stack(tabHolder, 4)
	local contentArea = mk("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ClipsDescendants = true,
		Position = UDim2Offset(sideW, 0),
		Size = UDim2New(1, -sideW, 1, 0),
	}, body)
	local window = setmetatable({
		ScreenGui = gui,
		Main = main,
		Tabs = {},
		ToggleKey = toggleKey,
		_main = main,
		_body = body,
		_tabHolder = tabHolder,
		_contentArea = contentArea,
		_titleLabel = titleLabel,
		_subLabel = subLabel,
		_items = {},
		_w = w,
		_h = h,
		_min = false,
		_shown = true,
	}, WindowMT)
	bar.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end
		local sx, sy = input.Position.X, input.Position.Y
		local p0 = main.Position
		beginDrag(function(i)
			local v = viewport()
			local x = p0.X.Offset + (i.Position.X - sx)
			local y = p0.Y.Offset + (i.Position.Y - sy)
			x = math.max(80 - main.AbsoluteSize.X, math.min(x, v.X - 80))
			y = math.max(0, math.min(y, v.Y - TB))
			main.Position = UDim2Offset(x, y)
		end, nil)
	end)
	minBtn.MouseButton1Click:Connect(function()
		window:Minimize()
	end)
	closeBtn.MouseButton1Click:Connect(function()
		if closeAction == "Hide" then
			window:SetVisible(false)
		else
			window:Destroy()
		end
	end)
	main.Parent = gui
	Library.Windows[#Library.Windows + 1] = window
	if config.MobileButton ~= false and UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		local mb = mk("TextButton", {
			Name = "MobileToggle",
			BackgroundColor3 = C.Card,
			BorderSizePixel = 0,
			AutoButtonColor = false,
			Position = UDim2Offset(12, 90),
			Size = UDim2Offset(44, 44),
			Text = string.upper(string.sub(title, 1, 1)),
			Font = FontBold,
			TextSize = 18,
			TextColor3 = C.Text,
			ZIndex = 60,
		})
		round(mb, 22)
		local st = outline(mb, C.Stroke, 2)
		track(st, function()
			st.Color = Accent
		end)
		mb.InputBegan:Connect(function(input)
			if not isPress(input) then
				return
			end
			local sx, sy = input.Position.X, input.Position.Y
			local p0 = mb.Position
			local moved = false
			beginDrag(function(i)
				local dx = i.Position.X - sx
				local dy = i.Position.Y - sy
				if math.abs(dx) > 6 or math.abs(dy) > 6 then
					moved = true
				end
				if moved then
					local v = viewport()
					local x = math.max(0, math.min(p0.X.Offset + dx, v.X - 44))
					local y = math.max(0, math.min(p0.Y.Offset + dy, v.Y - 44))
					mb.Position = UDim2Offset(x, y)
				end
			end, function()
				if not moved then
					window:Toggle()
				end
			end)
		end)
		mb.Parent = gui
		window._mobile = mb
	end
	return window
end

return Library
