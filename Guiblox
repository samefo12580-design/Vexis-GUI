----------------------------------------------------------------------
-- Slider (แตะตัวเลขเพื่อพิมพ์ค่าเองได้)
----------------------------------------------------------------------
function TabMT:CreateSlider(text, min, max, default, callback, flag, increment)
	min, max = tonumber(min) or 0, tonumber(max) or 100
	if max == min then max = min + 1 end
	local span = max - min
	local def = tonumber(default) or min
	local inc = tonumber(increment) or ((min % 1 == 0 and max % 1 == 0 and def % 1 == 0) and 1 or 0.01)
	if inc <= 0 then inc = 1 end
	local decimals = #(tostring(inc):match("%.(%d+)") or "")
	local function snap(v)
		v = math.clamp(tonumber(v) or min, min, max)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = tonumber(string.format("%." .. decimals .. "f", v)) or v
		return math.clamp(v, min, max)
	end
	local value = snap(initial(flag, def))

	local card = makeCard(self, 58)
	local cst = card:FindFirstChildOfClass("UIStroke")
	label(card, { Text = tostring(text or "Slider"), Font = Enum.Font.GothamMedium, Size = UDim2.new(1, -96, 0, 18), Position = UDim2.fromOffset(14, 8), TextTruncate = Enum.TextTruncate.AtEnd }, "Text")

	local vbox = new("TextBox", {
		Text = "", ClearTextOnFocus = true, Font = Enum.Font.GothamMedium, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center,
		Size = UDim2.fromOffset(68, 22), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 7),
	}, { BackgroundColor3 = "Input", TextColor3 = "Accent", PlaceholderColor3 = "Accent" })
	vbox.Parent = card
	corner(vbox, 5)
	local vstroke = stroke(vbox, "Stroke")

	local track = new("Frame", { Size = UDim2.new(1, -28, 0, 6), Position = UDim2.fromOffset(14, 40), BorderSizePixel = 0, Parent = card }, { BackgroundColor3 = "Input" })
	corner(track, 3)
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BorderSizePixel = 0, BackgroundColor3 = WHITE, Parent = track })
	corner(fill, 3)
	gradient(fill, 0)
	local knob = new("Frame", { Size = UDim2.fromOffset(14, 14), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), BorderSizePixel = 0, BackgroundColor3 = WHITE, ZIndex = 2, Parent = fill })
	corner(knob, 7)
	stroke(knob, "Accent")
	local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 0.5, -11), BackgroundTransparency = 1, Text = "", Parent = track })
	hoverStroke(hit, cst)

	local obj = { Instance = card, Type = "Slider", Default = snap(def) }
	local function visual()
		local txt = string.format("%." .. decimals .. "f", value)
		if not vbox:IsFocused() then vbox.Text = txt end
		vbox.PlaceholderText = txt
		fill.Size = UDim2.fromScale((value - min) / span, 1)
	end
	visual()

	function obj:Get() return value end
	function obj:Set(v, silent)
		v = snap(v)
		local changed = v ~= value
		value = v
		visual()
		if changed then emit(obj, silent) end
	end
	function obj:Reset() obj:Set(obj.Default) end

	vbox.Focused:Connect(function() setBind(vstroke, "Color", "Accent") end)
	vbox.FocusLost:Connect(function()
		setBind(vstroke, "Color", "Stroke")
		local raw = vbox.Text:gsub("%s", "")
		raw = raw:gsub(",", ".")
		local n = tonumber(raw)
		if n then obj:Set(n) end
		visual()
	end)

	local function fromInput(i)
		local ratio = math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		obj:Set(min + ratio * span)
	end
	hit.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		if vbox:IsFocused() then vbox:ReleaseFocus() end
		fromInput(input)
		startDrag(fromInput)
	end)
	return register(self, obj, flag, callback)
end

----------------------------------------------------------------------
-- Dropdown UI (ใช้ร่วมกันระหว่าง Dropdown และ MultiDropdown)
----------------------------------------------------------------------
local function newDropdownUI(tab, text, multi)
	local ROW, GAP, MAXV, HEAD = 26, 2, 6, 40
	local ui = { rows = {}, open = false, hasSearch = multi, shown = 0 }
	local card = makeCard(tab, HEAD)
	local cardStroke = card:FindFirstChildOfClass("UIStroke")
	ui.card = card

	label(card, { Text = tostring(text), Font = Enum.Font.GothamMedium, Size = UDim2.new(1, -150, 0, HEAD), Position = UDim2.fromOffset(14, 0), TextTruncate = Enum.TextTruncate.AtEnd }, "Text")

	local pill = new("Frame", { Size = UDim2.fromOffset(124, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 7), Parent = card }, { BackgroundColor3 = "Input" })
	corner(pill, 6)
	stroke(pill, "Stroke")
	local valueLbl = label(pill, { Text = "", Font = Enum.Font.GothamMedium, TextSize = 11, Size = UDim2.new(1, -28, 1, 0), Position = UDim2.fromOffset(8, 0), TextTruncate = Enum.TextTruncate.AtEnd }, "Accent")
	local chev = makeChevron(pill, UDim2.new(1, -13, 0.5, 0))

	local head = new("TextButton", { Size = UDim2.new(1, 0, 0, HEAD), BackgroundTransparency = 1, Text = "", ZIndex = 3, Parent = card })
	head.MouseEnter:Connect(function() setBind(cardStroke, "Color", "Accent") end)
	head.MouseLeave:Connect(function() if not ui.open then setBind(cardStroke, "Color", "Stroke") end end)

	local body = new("Frame", { Position = UDim2.fromOffset(0, HEAD), Size = UDim2.new(1, 0, 1, -HEAD), BackgroundTransparency = 1, Parent = card })
	new("Frame", { Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -16, 0, 1), BorderSizePixel = 0, Parent = body }, { BackgroundColor3 = "Stroke" })

	local searchRow = new("Frame", { Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 0, 24), BackgroundTransparency = 1, Visible = multi, Parent = body })
	local search = new("TextBox", {
		Text = "", PlaceholderText = "Search...", Font = Enum.Font.Gotham, TextSize = 11, ClearTextOnFocus = false,
		TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, multi and -88 or 0, 1, 0), Parent = searchRow,
	}, { BackgroundColor3 = "Input", TextColor3 = "Text", PlaceholderColor3 = "SubText" })
	corner(search, 5)
	pad(search, 8, 0, 8, 0)

	if multi then
		local function mini(txt, w, x, fn)
			local b = new("TextButton", {
				Text = txt, Font = Enum.Font.GothamMedium, TextSize = 11, Size = UDim2.fromOffset(w, 24), AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, x, 0, 0), AutoButtonColor = false, Parent = searchRow,
			}, { BackgroundColor3 = "Input", TextColor3 = "Accent" })
			corner(b, 5)
			b.MouseButton1Click:Connect(fn)
		end
		local function visibleNames()
			local out = {}
			for _, r in ipairs(ui.rows) do if r.btn.Visible then table.insert(out, r.name) end end
			return out
		end
		mini("Clear", 42, 0, function() if ui.onBulk then ui.onBulk(false, visibleNames()) end end)
		mini("All", 36, -46, function() if ui.onBulk then ui.onBulk(true, visibleNames()) end end)
	end

	local holder = new("ScrollingFrame", {
		Position = UDim2.fromOffset(8, 6), Size = UDim2.new(1, -16, 0, ROW), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), Parent = body,
	}, { ScrollBarImageColor3 = "Accent" })
	list(holder, GAP)
	local empty = label(body, { Text = "No results", TextSize = 11, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, -16, 0, ROW), Position = UDim2.fromOffset(8, 6), Visible = false }, "SubText")

	local function y0() return ui.hasSearch and 36 or 6 end
	local function listH() return math.min(math.max(ui.shown, 1), MAXV) * (ROW + GAP) end
	local function openH() return HEAD + y0() + listH() + 6 end

	local function relayout()
		searchRow.Visible = ui.hasSearch
		holder.Position = UDim2.fromOffset(8, y0())
		empty.Position = UDim2.fromOffset(8, y0())
		holder.Size = UDim2.new(1, -16, 0, listH())
		if ui.open then card.Size = UDim2.new(1, 0, 0, openH()) end
	end

	function ui.filter()
		local q = search.Text:lower()
		local n = 0
		for _, r in ipairs(ui.rows) do
			local show = q == "" or r.name:lower():find(q, 1, true) ~= nil
			r.btn.Visible = show
			if show then n = n + 1 end
		end
		ui.shown = n
		empty.Visible = n == 0
		holder.CanvasPosition = Vector2.new(0, 0)
		relayout()
	end
	search:GetPropertyChangedSignal("Text"):Connect(ui.filter)

	function ui.setValue(s) valueLbl.Text = tostring(s) end

	function ui.setOpen(state)
		ui.open = state and true or false
		if ui.open then
			local o = Library._openDD
			if o and o ~= ui and o.open then o.setOpen(false) end
			Library._openDD = ui
		elseif Library._openDD == ui then
			Library._openDD = nil
		end
		if not ui.open and search.Text ~= "" then search.Text = "" end
		setBind(cardStroke, "Color", ui.open and "Accent" or "Stroke")
		chev.Rotation = ui.open and 180 or 0
		card.Size = UDim2.new(1, 0, 0, ui.open and openH() or HEAD)
	end
	head.MouseButton1Click:Connect(function() ui.setOpen(not ui.open) end)

	function ui.paint(r, on)
		r.on = on
		setBind(r.lbl, "TextColor3", on and "Accent" or "Text")
		if multi then
			setBind(r.box, "BackgroundColor3", on and "Accent" or "Input")
			setBind(r.boxStroke, "Color", on and "Accent" or "Stroke")
		else
			r.btn.BackgroundTransparency = on and 0 or 1
			r.bar.Visible = on
		end
	end

	function ui.build(options, onClick)
		for _, r in ipairs(ui.rows) do r.btn:Destroy() end
		ui.rows = {}
		ui.hasSearch = multi or #options > MAXV
		for i, o in ipairs(options) do
			local name = tostring(o)
			local b = new("TextButton", {
				Text = "", Size = UDim2.new(1, -4, 0, ROW), BackgroundTransparency = 1, AutoButtonColor = false, LayoutOrder = i, Parent = holder,
			}, { BackgroundColor3 = "AccentSoft" })
			corner(b, 5)
			local r = { btn = b, name = name, value = o, on = false }
			if multi then
				r.lbl = label(b, { Text = name, Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -38, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd }, "Text")
				r.box = new("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, 10, 0.5, -7), Parent = b }, { BackgroundColor3 = "Input" })
				corner(r.box, 4)
				r.boxStroke = stroke(r.box, "Stroke")
			else
				r.lbl = label(b, { Text = name, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -20, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd }, "Text")
				r.bar = new("Frame", { Size = UDim2.fromOffset(3, 12), Position = UDim2.new(0, 3, 0.5, -6), BorderSizePixel = 0, Visible = false, Parent = b }, { BackgroundColor3 = "Accent" })
				corner(r.bar, 2)
			end
			b.MouseButton1Click:Connect(function() onClick(o, r) end)
			table.insert(ui.rows, r)
		end
		ui.shown = #options
		empty.Visible = #options == 0
		if search.Text ~= "" then search.Text = "" end
		relayout()
	end

	return ui
end

----------------------------------------------------------------------
-- Dropdown
----------------------------------------------------------------------
function TabMT:CreateDropdown(text, options, default, callback, flag)
	options = options or {}
	local selected = initial(flag, default)
	local function find(v)
		for _, o in ipairs(options) do if tostring(o) == tostring(v) then return o end end
		return nil
	end
	local function fix()
		local m = find(selected)
		if m == nil then m = find(default) end
		if m == nil then m = options[1] end
		selected = m
	end
	fix()

	local ui = newDropdownUI(self, text or "Dropdown", false)
	local obj = { Instance = ui.card, Type = "Dropdown", Default = default }

	local function paint()
		for _, r in ipairs(ui.rows) do ui.paint(r, selected ~= nil and r.name == tostring(selected)) end
		ui.setValue(selected ~= nil and tostring(selected) or "Select...")
	end
	local function build()
		ui.build(options, function(o) obj:Set(o); ui.setOpen(false) end)
		paint()
	end

	function obj:Get() return selected end
	function obj:Set(v, silent)
		local m = find(v)
		if m == nil then return end
		local changed = tostring(m) ~= tostring(selected)
		selected = m
		paint()
		if changed then emit(obj, silent) end
	end
	function obj:Reset()
		local d = find(default)
		if d == nil then d = options[1] end
		if d ~= nil then obj:Set(d) end
	end
	function obj:Refresh(newOptions)
		options = newOptions or {}
		local before = selected
		fix()
		build()
		if tostring(before) ~= tostring(selected) then emit(obj, true) end
	end
	obj.SetValues = obj.Refresh
	build()
	return register(self, obj, flag, callback)
end

----------------------------------------------------------------------
-- MultiDropdown
----------------------------------------------------------------------
function TabMT:CreateMultiDropdown(text, options, defaults, callback, flag)
	options = options or {}
	local selected = {}
	local saved = initial(flag, nil)
	for _, v in ipairs(type(saved) == "table" and saved or defaults or {}) do selected[tostring(v)] = true end

	local ui = newDropdownUI(self, text or "Multi", true)
	local obj = { Instance = ui.card, Type = "MultiDropdown", Default = defaults or {} }

	local function getList()
		local out = {}
		for _, o in ipairs(options) do if selected[tostring(o)] then table.insert(out, tostring(o)) end end
		return out
	end
	local function paint()
		for _, r in ipairs(ui.rows) do ui.paint(r, selected[r.name] == true) end
		local l = getList()
		if #l == 0 then ui.setValue("None")
		elseif #l == 1 then ui.setValue(l[1])
		else ui.setValue(#l .. " selected") end
	end
	local function build()
		ui.build(options, function(_, r)
			selected[r.name] = (not selected[r.name]) or nil
			paint()
			emit(obj, false)
		end)
		paint()
	end
	ui.onBulk = function(state, names)
		for _, n in ipairs(names) do selected[n] = state or nil end
		paint()
		emit(obj, false)
	end

	function obj:Get() return getList() end
	function obj:Set(listv, silent)
		selected = {}
		for _, v in ipairs(listv or {}) do selected[tostring(v)] = true end
		paint()
		emit(obj, silent)
	end
	function obj:Reset() obj:Set(obj.Default) end
	function obj:Refresh(newOptions)
		options = newOptions or {}
		local keep = {}
		for _, o in ipairs(options) do if selected[tostring(o)] then keep[tostring(o)] = true end end
		selected = keep
		build()
		emit(obj, true)
	end
	obj.SetValues = obj.Refresh
	build()
	return register(self, obj, flag, callback)
end

