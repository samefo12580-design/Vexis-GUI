	})
	local valueLabel = label(head, {
		AnchorPoint = Vector2New(1, 0),
		Position = UDim2New(1, -28, 0, 0),
		Size = UDim2New(0.5, -34, 1, 0),
		Text = "",
		TextSize = 12,
		TextColor3 = C.Sub,
		TextXAlignment = AlignRight,
		TextTruncate = TruncEnd,
	})
	local arrow = label(head, {
		AnchorPoint = Vector2New(1, 0),
		Position = UDim2New(1, -10, 0, 0),
		Size = UDim2Offset(14, 34),
		Text = "v",
		Font = FontBold,
		TextSize = 11,
		TextColor3 = C.Sub,
		TextXAlignment = AlignCenter,
	})
	local listFrame = mk("ScrollingFrame", {
		Position = UDim2Offset(8, 38),
		Size = UDim2New(1, -16, 0, 32),
		BackgroundColor3 = C.Field,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = C.Sub,
		CanvasSize = UDim2New(0, 0, 0, 0),
		AutomaticCanvasSize = AutoY,
		ScrollingDirection = DirY,
		Visible = false,
	}, card)
	round(listFrame, 4)
	pad(listFrame, 3, 3, 3, 3)
	stack(listFrame, 2)
	local shell = {}
	local rows = {}
	local isSelected
	local isOpen = false
	local listH = 32
	local closeFn
	local function resize()
		if isOpen then
			card.Size = UDim2New(1, 0, 0, 34 + listH + 8)
		else
			card.Size = UDim2New(1, 0, 0, 34)
		end
	end
	local function paintRows()
		for i = 1, #rows do
			local r = rows[i]
			local on = false
			if isSelected then
				on = isSelected(r.value)
			end
			if on then
				r.btn.BackgroundColor3 = C.Hover
				r.lbl.TextColor3 = Accent
			else
				r.btn.BackgroundColor3 = C.Field
				r.lbl.TextColor3 = C.Text
			end
			if r.box then
				r.box.BackgroundColor3 = on and Accent or C.Off
			end
		end
	end
	track(card, paintRows)
	local function setOpen(state)
		if state == isOpen then
			return
		end
		if state then
			closeOpen()
			openClose = closeFn
		elseif openClose == closeFn then
			openClose = nil
		end
		isOpen = state
		listFrame.Visible = state
		arrow.Text = state and "^" or "v"
		resize()
	end
	closeFn = function()
		setOpen(false)
	end
	head.MouseButton1Click:Connect(function()
		setOpen(not isOpen)
	end)
	function shell.setHeader(s)
		valueLabel.Text = s
	end
	function shell.refreshRows()
		paintRows()
	end
	function shell.close()
		setOpen(false)
	end
	function shell.rebuild(opts, sel)
		isSelected = sel
		for i = 1, #rows do
			rows[i].btn:Destroy()
		end
		rows = {}
		for i = 1, #opts do
			local v = opts[i]
			local btn = mk("TextButton", {
				BackgroundColor3 = C.Field,
				BorderSizePixel = 0,
				AutoButtonColor = false,
				Text = "",
				Size = UDim2New(1, 0, 0, 26),
				LayoutOrder = i,
			})
			round(btn, 4)
			local row = { btn = btn, value = v }
			if multi then
				local cb = mk("Frame", {
					Position = UDim2Offset(8, 6),
					Size = UDim2Offset(14, 14),
					BackgroundColor3 = C.Off,
					BorderSizePixel = 0,
				}, btn)
				round(cb, 3)
				row.box = cb
			end
			row.lbl = label(btn, {
				Position = UDim2Offset(multi and 30 or 10, 0),
				Size = UDim2New(1, multi and -36 or -16, 1, 0),
				Text = tostring(v),
				TextSize = 12,
				TextTruncate = TruncEnd,
			})
			btn.MouseButton1Click:Connect(function()
				onPick(v)
			end)
			btn.Parent = listFrame
			rows[i] = row
		end
		local vis = math.min(math.max(#opts, 1), 6)
		listH = vis * 26 + (vis - 1) * 2 + 6
		listFrame.Size = UDim2New(1, -16, 0, listH)
		paintRows()
		resize()
	end
	function shell.cleanup()
		if openClose == closeFn then
			openClose = nil
		end
	end
	shell.card = card
	return shell
end

function ContainerMT:CreateDropdown(text, options, default, callback, flag)
	local opts = toList(options)
	local value = nil
	local shell
	local obj = newObj()
	local function findIndex(v)
		if v == nil then
			return nil
		end
		local s = tostring(v)
		for i = 1, #opts do
			if tostring(opts[i]) == s then
				return i
			end
		end
		return nil
	end
	local function isSel(v)
		return value ~= nil and tostring(value) == tostring(v)
	end
	local function commit(v, silent)
		value = v
		if flag ~= nil then
			Library.Flags[flag] = v
		end
		if v == nil then
			shell.setHeader("None")
		else
			shell.setHeader(tostring(v))
		end
		shell.refreshRows()
		if not silent then
			call(callback, v)
		end
	end
	shell = dropdownShell(self, text, false, function(v)
		commit(v, false)
		shell.close()
	end)
	local idx = findIndex(default)
	if idx then
		value = opts[idx]
	elseif default ~= nil then
		value = default
	end
	local initial = value
	shell.rebuild(opts, isSel)
	commit(value, true)
	function obj:Get()
		return value
	end
	function obj:Set(v, silent)
		local i = findIndex(v)
		if i then
			commit(opts[i], silent)
		else
			commit(v, silent)
		end
	end
	function obj:Reset()
		obj:Set(initial, false)
	end
	function obj:Refresh(newOptions)
		opts = toList(newOptions)
		if value ~= nil and not findIndex(value) then
			commit(nil, true)
		end
		shell.rebuild(opts, isSel)
	end
	obj.SetValues = obj.Refresh
	obj._cleanup = shell.cleanup
	attach(self, obj, shell.card, "Dropdown", flag)
	if Library.FireOnInit and value ~= nil then
		taskDefer(call, callback, value)
	end
	return obj
end

function ContainerMT:CreateMultiDropdown(text, options, defaults, callback, flag)
	local opts = toStrings(options)
	local selected = {}
	local shell
	local obj = newObj()
	local function listOut()
		local out = {}
		for i = 1, #opts do
			if selected[opts[i]] then
				out[#out + 1] = opts[i]
			end
		end
		return out
	end
	local function commit(silent)
		local out = listOut()
		if flag ~= nil then
			Library.Flags[flag] = out
		end
		if #out == 0 then
			shell.setHeader("None")
		else
			shell.setHeader(table.concat(out, ", "))
		end
		shell.refreshRows()
		if not silent then
			call(callback, out)
		end
	end
	local function isSel(v)
		return selected[v] == true
	end
	local function load(list)
		selected = {}
		if type(list) == "table" then
			for k, v in next, list do
				if type(k) == "number" then
					selected[tostring(v)] = true
				elseif v then
					selected[tostring(k)] = true
				end
			end
		end
	end
	shell = dropdownShell(self, text, true, function(v)
		selected[v] = not selected[v]
		commit(false)
	end)
	load(defaults)
	local initial = listOut()
	shell.rebuild(opts, isSel)
	commit(true)
	function obj:Get()
		return listOut()
	end
	function obj:Set(list, silent)
		load(list)
		commit(silent)
	end
	function obj:Reset()
		obj:Set(initial, false)
	end
	function obj:Refresh(newOptions)
		opts = toStrings(newOptions)
		shell.rebuild(opts, isSel)
		commit(true)
	end
	obj.SetValues = obj.Refresh
	obj._cleanup = shell.cleanup
	attach(self, obj, shell.card, "MultiDropdown", flag)
	if Library.FireOnInit then
		taskDefer(call, callback, listOut())
	end
	return obj
end

