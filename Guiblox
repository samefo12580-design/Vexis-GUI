function TabMT:CreateTextBox(t, placeholder, callback, flag, height)
	local H = math.clamp(tonumber(height) or 120, 60, 400)
	local f = card(self, H + 36)
	text(f, { Text = tostring(t or "Text"), Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -120, 0, 30), TextTruncate = Enum.TextTruncate.AtEnd })
