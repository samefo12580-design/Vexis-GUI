function WindowMT:SetTitle(t) self.TitleLabel.Text = tostring(t) end
function WindowMT:SetVisible(v) self._shown = v and true or false; self.Main.Visible = self._shown end
function WindowMT:Toggle() self:SetVisible(not self._shown) end
function WindowMT:Notify(...) Library:Notify(...) end
function WindowMT:Minimize() self._setMin(true) end
function WindowMT:Destroy()
	for i, w in ipairs(Library.Windows) do if w == self then table.remove(Library.Windows, i) break end end
	if self.ScreenGui then self.ScreenGui:Destroy() end
	if #Library.Windows == 0 then Library:Unload() end
end

function WindowMT:SelectTab(tab)
	if self.ActiveTab == tab then return end
	if openDD and openDD.open then openDD.setOpen(false) end
	for _, t in ipairs(self.Tabs) do
		t.Page.Visible = false
		t.Button.BackgroundColor3 = C.side
		t.Button.TextColor3 = C.sub
		t.Bar.Visible = false
	end
	tab.Page.Visible = true
	tab.Button.BackgroundColor3 = C.card
	tab.Button.TextColor3 = C.text
	tab.Bar.BackgroundColor3 = Library.Accent
	tab.Bar.Visible = true
	self.ActiveTab = tab
end

function WindowMT:CreateTab(name)
	local win = self
	name = tostring(name or "Tab")
	local btn = mk("TextButton", {
		Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = C.side, BorderSizePixel = 0, Text = name, Font = Enum.Font.GothamMedium,
		TextSize = 13, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false,
		LayoutOrder = #self.Tabs + 1,
	}, self.TabList)
	round(btn, 5)
	padding(btn, 12, 0, 6, 0)
	local bar = mk("Frame", { Size = UDim2.fromOffset(3, 14), Position = UDim2.new(0, -9, 0.5, -7), BackgroundColor3 = Library.Accent, BorderSizePixel = 0, Visible = false }, btn)
	round(bar, 2)
	local page = mk("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
		CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
	}, self.Pages)
	padding(page, 0, 0, 6, 4)
	layout(page, 6)
	local tab = setmetatable({ Page = page, Button = btn, Bar = bar, Name = name, Window = win, n = 0 }, TabMT)
	function tab:Select() win:SelectTab(tab) end
	btn.MouseButton1Click:Connect(function() win:SelectTab(tab) end)
	btn.MouseEnter:Connect(function() if win.ActiveTab ~= tab then btn.BackgroundColor3 = C.card end end)
	btn.MouseLeave:Connect(function() if win.ActiveTab ~= tab then btn.BackgroundColor3 = C.side end end)
	self.Tabs[#self.Tabs + 1] = tab
	if #self.Tabs == 1 then self:SelectTab(tab) end
	return tab
end

local function parentGui(gui)
	local targets = {}
	if type(gethui) == "function" then targets[#targets + 1] = function() return gethui() end end
	targets[#targets + 1] = function() return CoreGui end
	targets[#targets + 1] = function() return LocalPlayer:WaitForChild("PlayerGui") end
	for _, get in ipairs(targets) do
		local ok, parent = pcall(get)
		if ok and parent then
			local old = parent:FindFirstChild(gui.Name)
			if old and old ~= gui then pcall(function() old:Destroy() end) end
		end
	end
	for _, get in ipairs(targets) do
		local ok = pcall(function() gui.Parent = get() end)
		if ok and gui.Parent then return end
	end
end

function Library:CreateWindow(config)
	if type(config) == "string" then config = { Title = config } end
	config = config or {}
	init()
	if typeof(config.Accent) == "Color3" then self.Accent = config.Accent end
	if config.FireOnInit ~= nil then self.FireOnInit = config.FireOnInit end
	local titleText = tostring(config.Title or "Vortex UI")
	local closeAction = config.CloseAction or "Destroy"

	local gui = mk("ScreenGui", { Name = "VortexUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 999, ZIndexBehavior = Enum.ZIndexBehavior.Sibling })
	parentGui(gui)

	local Window = setmetatable({ ScreenGui = gui, Tabs = {}, ToggleKey = config.ToggleKey or Enum.KeyCode.RightControl, _shown = true }, WindowMT)
	Library.Windows[#Library.Windows + 1] = Window

	notifHolder = mk("Frame", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Size = UDim2.new(0, 240, 1, -24), BackgroundTransparency = 1 }, gui)
	mk("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom }, notifHolder)

	local vp = viewport()
	local want = config.Size or UDim2.fromOffset(540, 380)
	local W = math.clamp(want.X.Offset, 360, math.max(360, vp.X - 20))
	local H = math.clamp(want.Y.Offset, 260, math.max(260, vp.Y - 20))

	local Main = mk("Frame", {
		Name = "Main", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H),
		BackgroundColor3 = C.bg, BorderSizePixel = 0, ClipsDescendants = true, Active = true,
	}, gui)
	round(Main, 8)
	mk("UIStroke", { Color = C.line, Thickness = 1 }, Main)
	Window.Main = Main

	local Top = mk("Frame", { Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = C.side, BorderSizePixel = 0 }, Main)
	round(Top, 8)
	mk("Frame", { Size = UDim2.new(1, 0, 0, 8), Position = UDim2.new(0, 0, 1, -8), BackgroundColor3 = C.side, BorderSizePixel = 0 }, Top)
	mk("Frame", { Size = UDim2.fromOffset(3, 14), Position = UDim2.fromOffset(10, 9), BackgroundColor3 = Library.Accent, BorderSizePixel = 0 }, Top)
	Window.TitleLabel = text(Top, { Text = titleText, Font = Enum.Font.GothamBold, TextSize = 14, Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -90, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })

	local function topBtn(label, x)
		local b = mk("TextButton", {
			Text = label, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = C.sub, Size = UDim2.fromOffset(26, 22),
			AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, x, 0.5, 0), BackgroundColor3 = C.card, BorderSizePixel = 0, AutoButtonColor = false,
		}, Top)
		round(b, 4)
		b.MouseEnter:Connect(function() b.BackgroundColor3 = C.hover; b.TextColor3 = C.text end)
		b.MouseLeave:Connect(function() b.BackgroundColor3 = C.card; b.TextColor3 = C.sub end)
		return b
	end
	local CloseBtn = topBtn("x", -6)
	local MinBtn = topBtn("-", -36)

	local Side = mk("Frame", { Size = UDim2.new(0, 124, 1, -32), Position = UDim2.fromOffset(0, 32), BackgroundColor3 = C.side, BorderSizePixel = 0 }, Main)
	mk("Frame", { Size = UDim2.new(0, 1, 1, 0), Position = UDim2.new(1, -1, 0, 0), BackgroundColor3 = C.line, BorderSizePixel = 0 }, Side)
	local TabList = mk("ScrollingFrame", {
		Size = UDim2.new(1, -16, 1, -12), Position = UDim2.fromOffset(12, 8), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, Side)
	layout(TabList, 3)
	Window.TabList = TabList

	local Pages = mk("Frame", { Size = UDim2.new(1, -144, 1, -44), Position = UDim2.fromOffset(134, 38), BackgroundTransparency = 1, ClipsDescendants = true }, Main)
	Window.Pages = Pages

	local isMin = false
	local function setMin(state)
		isMin = state
		Side.Visible, Pages.Visible = not state, not state
		Main.Size = state and UDim2.fromOffset(W, 32) or UDim2.fromOffset(W, H)
	end
	Window._setMin = setMin
	MinBtn.MouseButton1Click:Connect(function() setMin(not isMin) end)
	CloseBtn.MouseButton1Click:Connect(function()
		if closeAction == "Hide" then Window:SetVisible(false) else Window:Destroy() end
	end)

	Top.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		local startMouse, startPos = input.Position, Main.Position
		startDrag(function(i)
			local d = i.Position - startMouse
			Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end)
	end)

	connect(UIS.InputBegan, function(input, gpe)
		if gpe or Library._listening then return end
		if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode == Window.ToggleKey then Window:Toggle() end
	end)

	if config.MobileButton ~= false and UIS.TouchEnabled and not UIS.KeyboardEnabled then
		local fab = mk("TextButton", {
			Text = titleText:sub(1, 1):upper(), Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = C.white, Size = UDim2.fromOffset(40, 40),
			Position = UDim2.fromOffset(10, vp.Y / 2), BackgroundColor3 = Library.Accent, BorderSizePixel = 0, AutoButtonColor = false, ZIndex = 50,
		}, gui)
		round(fab, 20)
		fab.InputBegan:Connect(function(input)
			if not isPress(input) then return end
			local startIn, startPos, moved = input.Position, fab.AbsolutePosition, false
			startDrag(function(i)
				local d = i.Position - startIn
				if d.Magnitude > 8 then moved = true end
				if moved then fab.Position = UDim2.fromOffset(startPos.X + d.X, startPos.Y + d.Y) end
			end, function()
				if not moved then Window:Toggle() end
			end)
		end)
	end

	return Window
end

return Library
