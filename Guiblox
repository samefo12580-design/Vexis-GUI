function ContainerMT:CreateParagraph(title, content)
	local card = makeCard(self, 0, true)
	pad(card, 12, 8, 12, 8)
	stack(card, 3)
	local t = label(card, {
		Size = UDim2New(1, 0, 0, 16),
		AutomaticSize = AutoY,
		Text = tostring(title or ""),
		Font = FontBold,
		TextWrapped = true,
		LayoutOrder = 1,
	})
	local b = label(card, {
		Size = UDim2New(1, 0, 0, 14),
		AutomaticSize = AutoY,
		Text = tostring(content or ""),
		TextSize = 12,
		TextColor3 = C.Sub,
		TextWrapped = true,
		TextYAlignment = AlignTop,
		LayoutOrder = 2,
	})
	local obj = newObj()
	function obj:SetTitle(s)
		t.Text = tostring(s)
	end
	function obj:SetContent(s, color)
		b.Text = tostring(s)
		if typeof(color) == "Color3" then
			b.TextColor3 = color
		else
			b.TextColor3 = C.Sub
		end
	end
	function obj:GetContent()
		return b.Text
	end
	return attach(self, obj, card, "Paragraph", nil)
end

function ContainerMT:CreateButton(text, callback)
	local card = makeCard(self, 34, false, "TextButton")
	local lbl = label(card, {
		Position = UDim2Offset(14, 0),
		Size = UDim2New(1, -22, 1, 0),
		Text = tostring(text),
		TextTruncate = TruncEnd,
	})
	local bar = mk("Frame", {
		BorderSizePixel = 0,
		Position = UDim2New(0, 0, 0.5, -8),
		Size = UDim2Offset(3, 16),
	}, card)
	round(bar, 2)
	track(bar, function()
		bar.BackgroundColor3 = Accent
	end)
	card.MouseEnter:Connect(function()
		card.BackgroundColor3 = C.Hover
	end)
	card.MouseLeave:Connect(function()
		card.BackgroundColor3 = C.Card
	end)
	card.InputEnded:Connect(function(input)
		if input.UserInputType == InputTouch then
			card.BackgroundColor3 = C.Card
		end
	end)
	local obj = newObj()
	card.MouseButton1Click:Connect(function()
		call(callback)
	end)
	function obj:Fire()
		call(callback)
	end
	function obj:SetText(s)
		lbl.Text = tostring(s)
	end
	return attach(self, obj, card, "Button", nil)
end

function ContainerMT:CreateToggle(text, default, callback, flag, desc)
	local hasDesc = desc ~= nil and tostring(desc) ~= ""
	local card = makeCard(self, hasDesc and 48 or 34, false, "TextButton")
	local lbl
	if hasDesc then
		lbl = label(card, {
			Position = UDim2Offset(12, 6),
			Size = UDim2New(1, -66, 0, 18),
			Text = tostring(text),
			TextTruncate = TruncEnd,
		})
		label(card, {
			Position = UDim2Offset(12, 25),
			Size = UDim2New(1, -66, 0, 16),
			Text = tostring(desc),
			TextSize = 11,
			TextColor3 = C.Sub,
			TextTruncate = TruncEnd,
		})
	else
		lbl = label(card, {
			Position = UDim2Offset(12, 0),
			Size = UDim2New(1, -66, 1, 0),
			Text = tostring(text),
			TextTruncate = TruncEnd,
		})
	end
	local sw = mk("Frame", {
		AnchorPoint = Vector2New(1, 0.5),
		Position = UDim2New(1, -12, 0.5, 0),
		Size = UDim2Offset(34, 18),
		BackgroundColor3 = C.Off,
		BorderSizePixel = 0,
	}, card)
	round(sw, 9)
	local knob = mk("Frame", {
		Position = UDim2Offset(3, 3),
		Size = UDim2Offset(12, 12),
		BackgroundColor3 = C.Text,
		BorderSizePixel = 0,
	}, sw)
	round(knob, 6)
	local value = default and true or false
	local initial = value
	local function paint()
		if value then
			sw.BackgroundColor3 = Accent
			knob.Position = UDim2Offset(19, 3)
		else
			sw.BackgroundColor3 = C.Off
			knob.Position = UDim2Offset(3, 3)
		end
	end
	track(sw, paint)
	if flag ~= nil then
		Library.Flags[flag] = value
	end
	local obj = newObj()
	function obj:Get()
		return value
	end
	function obj:Set(v, silent)
		value = v and true or false
		paint()
		if flag ~= nil then
			Library.Flags[flag] = value
		end
		if not silent then
			call(callback, value)
		end
	end
	function obj:Reset()
		obj:Set(initial, false)
	end
	function obj:SetText(s)
		lbl.Text = tostring(s)
	end
	card.MouseButton1Click:Connect(function()
		obj:Set(not value, false)
	end)
	attach(self, obj, card, "Toggle", flag)
	if Library.FireOnInit then
		taskDefer(call, callback, value)
	end
	return obj
end

function ContainerMT:CreateSlider(text, min, max, default, callback, flag, increment)
	min = tonumber(min) or 0
	max = tonumber(max) or 100
	if max < min then
		min, max = max, min
	end
	local inc = tonumber(increment)
	if not inc or inc <= 0 then
		if min % 1 == 0 and max % 1 == 0 and (max - min) > 1 then
			inc = 1
		else
			inc = 0.01
		end
	end
	local dec = 0
	local probe = inc
	while dec < 6 and math.abs(probe - math.floor(probe + 0.5)) > 0.000001 do
		probe = probe * 10
		dec = dec + 1
	end
	local function snap(v)
		v = tonumber(v) or min
		if v < min then
			v = min
		end
		if v > max then
			v = max
		end
		v = min + math.floor((v - min) / inc + 0.5) * inc
		if v > max then
			v = max
		end
		if v < min then
			v = min
		end
		return tonumber(string.format("%." .. dec .. "f", v))
	end
	local card = makeCard(self, 50)
	label(card, {
		Position = UDim2Offset(12, 6),
		Size = UDim2New(1, -88, 0, 20),
		Text = tostring(text),
		TextTruncate = TruncEnd,
	})
	local box = mk("TextBox", {
		AnchorPoint = Vector2New(1, 0),
		Position = UDim2New(1, -10, 0, 6),
		Size = UDim2Offset(58, 20),
		BackgroundColor3 = C.Field,
		BorderSizePixel = 0,
		Text = "",
		TextColor3 = C.Text,
		Font = FontMedium,
		TextSize = 12,
		ClearTextOnFocus = false,
	}, card)
	round(box, 4)
	outline(box, C.Stroke, 1)
	local bar = mk("Frame", {
		Position = UDim2Offset(12, 36),
		Size = UDim2New(1, -24, 0, 6),
		BackgroundColor3 = C.Off,
		BorderSizePixel = 0,
	}, card)
	round(bar, 3)
	local fill = mk("Frame", {
		Size = UDim2New(0, 0, 1, 0),
		BorderSizePixel = 0,
	}, bar)
	round(fill, 3)
	track(fill, function()
		fill.BackgroundColor3 = Accent
	end)
	local hit = mk("TextButton", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Position = UDim2Offset(0, 26),
		Size = UDim2New(1, 0, 0, 24),
	}, card)
	local value = snap(default)
	local initial = value
	local function render()
		local frac = 0
		if max > min then
			frac = (value - min) / (max - min)
		end
		fill.Size = UDim2New(frac, 0, 1, 0)
		box.Text = tostring(value)
		if flag ~= nil then
			Library.Flags[flag] = value
		end
	end
	local function apply(v, silent, onlyChange)
		local nv = snap(v)
		local changed = nv ~= value
		value = nv
		render()
		if not silent and (changed or not onlyChange) then
			call(callback, value)
		end
	end
	local function fromInput(input)
		local w = bar.AbsoluteSize.X
		if w <= 0 then
			return
		end
		local rel = (input.Position.X - bar.AbsolutePosition.X) / w
		if rel < 0 then
			rel = 0
		elseif rel > 1 then
			rel = 1
		end
		apply(min + (max - min) * rel, false, true)
	end
	hit.InputBegan:Connect(function(input)
		if not isPress(input) then
			return
		end
		fromInput(input)
		beginDrag(fromInput, lockScroll(card))
	end)
	box.FocusLost:Connect(function()
		local n = tonumber(box.Text)
		if n then
			apply(n, false, true)
		else
			render()
		end
	end)
	render()
	local obj = newObj()
	function obj:Get()
		return value
	end
	function obj:Set(v, silent)
		apply(v, silent, false)
	end
	function obj:Reset()
		apply(initial, false, false)
	end
	attach(self, obj, card, "Slider", flag)
	if Library.FireOnInit then
		taskDefer(call, callback, value)
	end
	return obj
end

local function dropdownShell(c, text, multi, onPick)
	local card = makeCard(c, 34)
	card.ClipsDescendants = true
	local head = mk("TextButton", {
