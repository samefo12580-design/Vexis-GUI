local function call(fn, ...)
	if type(fn) == "function" then
		pcall(fn, ...)
	end
end

local function isPress(input)
	local t = input.UserInputType
	return t == InputMouse1 or t == InputTouch
end

local function mk(class, props, parent)
	local o = InstanceNew(class)
	for k, v in next, props do
		o[k] = v
	end
	if parent then
		o.Parent = parent
	end
	return o
end

local function round(p, r)
	return mk("UICorner", { CornerRadius = UDimNew(0, r or 6) }, p)
end

local function outline(p, col, th)
	return mk("UIStroke", { Color = col or C.Stroke, Thickness = th or 1, ApplyStrokeMode = StrokeBorder }, p)
end

local function pad(p, l, t, r, b)
	return mk("UIPadding", {
		PaddingLeft = UDimNew(0, l or 0),
		PaddingTop = UDimNew(0, t or 0),
		PaddingRight = UDimNew(0, r or 0),
		PaddingBottom = UDimNew(0, b or 0),
	}, p)
end

local function stack(p, gap)
	return mk("UIListLayout", { Padding = UDimNew(0, gap or 0), SortOrder = SortLayout }, p)
end

local function label(parent, props)
	props.BackgroundTransparency = 1
	props.BorderSizePixel = 0
	props.Font = props.Font or FontRegular
	props.TextSize = props.TextSize or 13
	props.TextColor3 = props.TextColor3 or C.Text
	props.TextXAlignment = props.TextXAlignment or AlignLeft
	return mk("TextLabel", props, parent)
end

local function track(inst, fn)
	accentFns[inst] = fn
	fn()
end

local function untrackTree(inst)
	accentFns[inst] = nil
	for _, d in next, inst:GetDescendants() do
		accentFns[d] = nil
	end
end

local function closeOpen()
	local f = openClose
	openClose = nil
	if f then
		pcall(f)
	end
end

local function viewport()
	local cam = Workspace.CurrentCamera
	if cam then
		return cam.ViewportSize
	end
	return Vector2New(1280, 720)
end

local function toList(options)
	local out = {}
	if type(options) == "table" then
		for i = 1, #options do
			if options[i] ~= nil then
				out[#out + 1] = options[i]
			end
		end
	end
	return out
end

local function toStrings(options)
	local out = toList(options)
	for i = 1, #out do
		out[i] = tostring(out[i])
	end
	return out
end

local function parseHex(s)
	local r, g, b = string.match(tostring(s), "^%s*#?(%x%x)(%x%x)(%x%x)%s*$")
	if not r then
		return nil
	end
	return Color3RGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
end

local function beginDrag(onMove, onEnd)
	dragMove, dragEnd = onMove, onEnd
end

local function endDrag()
	local e = dragEnd
	dragMove, dragEnd = nil, nil
	if e then
		pcall(e)
	end
end

local function lockScroll(card)
	local sf = card:FindFirstAncestorOfClass("ScrollingFrame")
	if sf then
		sf.ScrollingEnabled = false
	end
	return function()
		if sf then
			sf.ScrollingEnabled = true
		end
	end
end

local function handleKey(input, gpe)
	if input.UserInputType ~= InputKeyboard then
		return
	end
	local key = input.KeyCode
	if listening then
		local l = listening
		listening = nil
		pcall(l, key)
		return
	end
	if gpe then
		return
	end
	for i = #Library.Windows, 1, -1 do
		local w = Library.Windows[i]
		if w and w.ToggleKey == key then
			pcall(w.Toggle, w)
		end
	end
	for i = #keybinds, 1, -1 do
		local k = keybinds[i]
		if k and k.Value == key and key ~= KeyUnknown then
			call(k._callback, key)
		end
	end
end

local function ensureInput()
	if inputReady then
		return
	end
	inputReady = true
	conns[#conns + 1] = UserInputService.InputChanged:Connect(function(input)
		if dragMove then
			local t = input.UserInputType
			if t == InputMouseMove or t == InputTouch then
				pcall(dragMove, input)
			end
		end
	end)
	conns[#conns + 1] = UserInputService.InputEnded:Connect(function(input)
		if dragMove and isPress(input) then
			endDrag()
		end
	end)
	conns[#conns + 1] = UserInputService.InputBegan:Connect(function(input, gpe)
		handleKey(input, gpe)
	end)
end

local function destroyOld()
	local list = {}
	if type(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and h then
			list[#list + 1] = h
		end
	end
	list[#list + 1] = CoreGui
	local lp = Players.LocalPlayer
	if lp then
		local pg = lp:FindFirstChildOfClass("PlayerGui")
		if pg then
			list[#list + 1] = pg
		end
	end
	for i = 1, #list do
		pcall(function()
			for _, g in next, list[i]:GetChildren() do
				if g.Name == GUI_NAME then
					g:Destroy()
				end
			end
		end)
	end
end

local function attachGui(gui)
	if type(syn) == "table" and type(syn.protect_gui) == "function" then
		pcall(syn.protect_gui, gui)
	end
	local done = false
	if type(gethui) == "function" then
		pcall(function()
			gui.Parent = gethui()
		end)
		done = gui.Parent ~= nil
	end
	if not done then
		pcall(function()
			gui.Parent = CoreGui
		end)
		done = gui.Parent ~= nil
	end
	if not done then
		local lp = Players.LocalPlayer
		local pg = lp and lp:FindFirstChildOfClass("PlayerGui")
		if pg then
			pcall(function()
				gui.Parent = pg
			end)
		end
	end
end

local function getRoot()
	if root and root.Parent then
		return root
	end
	destroyOld()
	root = mk("ScreenGui", {
		Name = GUI_NAME,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 999,
		ZIndexBehavior = ZSibling,
	})
	attachGui(root)
	notifHolder = mk("Frame", {
		Name = "Notifications",
		AnchorPoint = Vector2New(1, 1),
		Position = UDim2New(1, -14, 1, -14),
		Size = UDim2New(0, 260, 1, -28),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 100,
	}, root)
	mk("UIListLayout", {
		Padding = UDimNew(0, 6),
		SortOrder = SortLayout,
		VerticalAlignment = VAlignBottom,
	}, notifHolder)
	ensureInput()
	return root
end

function Library:Notify(title, content, duration, kind)
	pcall(function()
		getRoot()
		local col = Accent
		if kind == "success" then
			col = C.Ok
		elseif kind == "error" then
			col = C.Err
		elseif kind == "warning" then
			col = C.Warn
		end
		notifOrder = notifOrder + 1
		local frame = mk("Frame", {
			BackgroundColor3 = C.Card,
			BorderSizePixel = 0,
			Size = UDim2New(1, 0, 0, 0),
			AutomaticSize = AutoY,
			LayoutOrder = notifOrder,
		})
		round(frame, 6)
		outline(frame, C.Stroke, 1)
		pad(frame, 12, 8, 10, 8)
		stack(frame, 2)
		label(frame, {
			Size = UDim2New(1, 0, 0, 16),
			AutomaticSize = AutoY,
			Text = tostring(title or ""),
			Font = FontBold,
			TextColor3 = col,
			TextWrapped = true,
			LayoutOrder = 1,
		})
		label(frame, {
			Size = UDim2New(1, 0, 0, 14),
			AutomaticSize = AutoY,
			Text = tostring(content or ""),
			TextSize = 12,
			TextColor3 = C.Sub,
			TextWrapped = true,
			TextYAlignment = AlignTop,
			LayoutOrder = 2,
		})
		frame.Parent = notifHolder
		notifs[#notifs + 1] = frame
		if #notifs > 6 then
			local old = table.remove(notifs, 1)
			pcall(function()
				old:Destroy()
			end)
		end
		taskDelay(tonumber(duration) or 4, function()
			pcall(function()
				frame:Destroy()
			end)
		end)
	end)
end

function Library:SetAccent(color)
	if typeof(color) ~= "Color3" then
		return
	end
	Accent = color
	for inst, fn in next, accentFns do
		if inst.Parent then
			pcall(fn)
		else
			accentFns[inst] = nil
		end
	end
end

function Library:SetTheme()
end

function Library:SaveConfig()
	return false
end

function Library:LoadConfig()
	return false
end

function Library:ResetConfig()
	return false
end

function Library:Unload()
	for i = #Library.Windows, 1, -1 do
		local w = Library.Windows[i]
		if w then
			pcall(w.Destroy, w)
		end
	end
	for i = 1, #conns do
		local c = conns[i]
		pcall(function()
			c:Disconnect()
		end)
	end
	conns = {}
	inputReady = false
	dragMove, dragEnd = nil, nil
	listening = nil
	openClose = nil
	keybinds = {}
	notifs = {}
	accentFns = {}
	for k in next, Library.Flags do
		Library.Flags[k] = nil
	end
	for k in next, Library.Elements do
		Library.Elements[k] = nil
	end
	if root then
		pcall(function()
			root:Destroy()
		end)
	end
	root, notifHolder = nil, nil
end

function ElemMT:SetVisible(v)
	if self.Instance then
		self.Instance.Visible = v and true or false
	end
end

function ElemMT:Destroy()
	if self._dead then
		return
	end
	self._dead = true
	if self._cleanup then
		pcall(self._cleanup)
	end
	local f = self.Flag
	if f ~= nil and Library.Elements[f] == self then
		Library.Elements[f] = nil
		Library.Flags[f] = nil
	end
	local inst = self.Instance
	if inst then
		pcall(untrackTree, inst)
		pcall(function()
			inst:Destroy()
		end)
	end
end

local function newObj()
	return setmetatable({}, ElemMT)
end

local function makeCard(c, h, auto, class)
	c._order = c._order + 1
	local props = {
		Name = "Card",
		BackgroundColor3 = C.Card,
		BorderSizePixel = 0,
		Size = UDim2New(1, 0, 0, h or 34),
		LayoutOrder = c._order,
	}
	if auto then
		props.AutomaticSize = AutoY
	end
	if class == "TextButton" then
		props.Text = ""
		props.AutoButtonColor = false
	end
	local card = mk(class or "Frame", props)
	round(card, 6)
	outline(card, C.Stroke, 1)
	card.Parent = c._content
	return card
end

local function attach(c, obj, card, kind, flag)
	obj.Instance = card
	obj.Type = kind
	obj.Flag = flag
	obj.Container = c
	c._items[#c._items + 1] = obj
	local w = c._win
	w._items[#w._items + 1] = obj
	if flag ~= nil then
		Library.Elements[flag] = obj
	end
	return obj
end

local function buildLabel(c, text, kind)
	c._order = c._order + 1
	local lbl = label(nil, {
		Name = "Label",
		Size = UDim2New(1, 0, 0, 22),
		AutomaticSize = AutoY,
		Text = tostring(text),
		TextWrapped = true,
		TextYAlignment = AlignMiddle,
		LayoutOrder = c._order,
	})
	pad(lbl, 4, 2, 4, 2)
	lbl.Parent = c._content
	local obj = newObj()
	function obj:SetText(s)
		lbl.Text = tostring(s)
	end
	return attach(c, obj, lbl, kind, nil)
end

function ContainerMT:CreateLabel(text)
