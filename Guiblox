			end
			local rel = (input.Position.X - bar.AbsolutePosition.X) / w
			if rel < 0 then
				rel = 0
			elseif rel > 1 then
				rel = 1
			end
			local v = math.floor(rel * 255 + 0.5)
			local r, g, b = channels()
			if i == 1 then
				if v == r then
					return
				end
				r = v
			elseif i == 2 then
				if v == g then
					return
				end
				g = v
			else
				if v == b then
					return
				end
				b = v
			end
			apply(Color3RGB(r, g, b), false)
		end
		hit.InputBegan:Connect(function(input)
			if not isPress(input) then
				return
			end
			fromInput(input)
			beginDrag(fromInput, lockScroll(card))
