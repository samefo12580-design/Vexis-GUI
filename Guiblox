end

function TabMT:CreateToggle(t, default, callback, flag, desc)
	local state = default == true
	local hasDesc = desc ~= nil and desc ~= ""
	local f = card(self, hasDesc and 48 or 34)
	local title = text(f, {
		Text = tostring(t or "Toggle"), Position = UDim2.fromOffset(10, hasDesc and 6 or 0),
		Size = UDim2.new(1, -62, 0, hasDesc and 18 or 34), TextTruncate = Enum.TextTruncate.AtEnd,
	})
	if hasDesc then
		text(f, { Text = tostring(desc), TextSize = 11, TextColor3 = C.sub, Position = UDim2.fromOffset(10, 24), Size = UDim2.new(1, -62, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd })
	end
	local sw = mk("Frame", { Size = UDim2.fromOffset(34, 18), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), BackgroundColor3 = C.input, BorderSizePixel = 0 }, f)
	round(sw, 9)
	local knob = mk("Frame", { Size = UDim2.fromOffset(12, 12), AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = C.sub, BorderSizePixel = 0 }, sw)
	round(knob, 6)
	local function visual()
		sw.BackgroundColor3 = state and Library.Accent or C.input
		knob.BackgroundColor3 = state and C.white or C.sub
		knob.Position = state and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
	end
	visual()
	local click = mk("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "" }, f)
	click.MouseEnter:Connect(function() f.BackgroundColor3 = C.hover end)
	click.MouseLeave:Connect(function() f.BackgroundColor3 = C.card end)
	local obj = { Instance = f, Type = "Toggle", Default = default == true }
	function obj:Get() return state end
	function obj:Set(v, silent)
		v = v and true or false
		local changed = v ~= state
		state = v
		visual()
		if changed then emit(obj, silent) end
	end
	function obj:Reset() obj:Set(obj.Default) end
	function obj:SetText(s) title.Text = tostring(s) end
	click.MouseButton1Click:Connect(function() obj:Set(not state) end)
	return register(obj, flag, callback)
end

function TabMT:CreateSlider(t, min, max, default, callback, flag, increment)
	min, max = tonumber(min) or 0, tonumber(max) or 100
	if max == min then max = min + 1 end
	local span = max - min
	local def = tonumber(default) or min
	local inc = tonumber(increment) or ((min % 1 == 0 and max % 1 == 0 and def % 1 == 0) and 1 or 0.01)
	local decimals = (tostring(inc):match("%.(%d+)") or ""):len()
	local function snap(v)
		v = math.clamp(tonumber(v) or min, min, max)
		v = math.floor((v - min) / inc + 0.5) * inc + min
		v = tonumber(string.format("%." .. decimals .. "f", v)) or v
		return math.clamp(v, min, max)
	end
	local value = snap(def)
	local f = card(self, 46)
	text(f, { Text = tostring(t or "Slider"), Position = UDim2.fromOffset(10, 5), Size = UDim2.new(1, -90, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
	local box = mk("TextBox", {
		Text = "", ClearTextOnFocus = true, Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = Library.Accent,
		TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromOffset(60, 20), AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 4), BackgroundColor3 = C.input, BorderSizePixel = 0,
	}, f)
	round(box, 4)
	local track = mk("Frame", { Size = UDim2.new(1, -20, 0, 6), Position = UDim2.fromOffset(10, 32), BackgroundColor3 = C.input, BorderSizePixel = 0 }, f)
	round(track, 3)
	local fill = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Library.Accent, BorderSizePixel = 0 }, track)
	round(fill, 3)
	local hit = mk("TextButton", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0.5, -10), BackgroundTransparency = 1, Text = "" }, track)
	local obj = { Instance = f, Type = "Slider", Default = snap(def) }
	local function visual()
		fill.Size = UDim2.fromScale((value - min) / span, 1)
		local s = string.format("%." .. decimals .. "f", value)
		if not box:IsFocused() then box.Text = s end
		box.PlaceholderText = s
	end
	visual()
	function obj:Get() return value end
	function obj:Set(v, silent)
		v = snap(v)
		local changed = v ~= value
		value = v
		visual()
		if changed then emit(obj, silent) end
	end
	function obj:Reset() obj:Set(obj.Default) end
	box.FocusLost:Connect(function()
		local n = tonumber((box.Text:gsub("%s", ""):gsub(",", ".")))
		if n then obj:Set(n) end
		visual()
	end)
	local function fromInput(i)
		obj:Set(min + math.clamp((i.Position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1) * span)
	end
	hit.InputBegan:Connect(function(input)
		if not isPress(input) then return end
		if box:IsFocused() then box:ReleaseFocus() end
		fromInput(input)
		startDrag(fromInput)
	end)
	return register(obj, flag, callback)
end

local function newDropdown(tab, name, multi)
	local HEAD, ROW, MAX = 34, 24, 6
	local f = card(tab, HEAD)
	local ui = { rows = {}, open = false, card = f }
	text(f, { Text = tostring(name), Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -150, 0, HEAD), TextTruncate = Enum.TextTruncate.AtEnd })
	local val = text(f, {
		Text = "", TextColor3 = Library.Accent, TextXAlignment = Enum.TextXAlignment.Right, TextSize = 12,
		Position = UDim2.new(1, -144, 0, 0), Size = UDim2.fromOffset(116, HEAD), TextTruncate = Enum.TextTruncate.AtEnd,
	})
	local arrow = text(f, { Text = "v", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Center, Position = UDim2.new(1, -24, 0, 0), Size = UDim2.fromOffset(16, HEAD) })
	local head = mk("TextButton", { Size = UDim2.new(1, 0, 0, HEAD), BackgroundTransparency = 1, Text = "" }, f)
	local holder = mk("ScrollingFrame", {
		Position = UDim2.fromOffset(6, HEAD), Size = UDim2.new(1, -12, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, f)
	layout(holder, 2)
	function ui.resize()
		local n = math.min(#ui.rows, MAX)
		holder.Size = UDim2.new(1, -12, 0, n * (ROW + 2))
		f.Size = UDim2.new(1, 0, 0, ui.open and (HEAD + n * (ROW + 2) + 6) or HEAD)
	end
	function ui.setOpen(state)
		ui.open = state and true or false
		if ui.open then
			if openDD and openDD ~= ui and openDD.open then openDD.setOpen(false) end
			openDD = ui
		elseif openDD == ui then
			openDD = nil
		end
		arrow.Text = ui.open and "^" or "v"
		ui.resize()
	end
	head.MouseButton1Click:Connect(function() ui.setOpen(not ui.open) end)
	function ui.setValue(s) val.Text = tostring(s) end
	function ui.paint(r, on)
		r.on = on
		r.btn.BackgroundColor3 = on and Library.Accent or C.input
		r.btn.TextColor3 = on and C.white or C.text
	end
	function ui.build(options, onClick)
		for _, r in ipairs(ui.rows) do r.btn:Destroy() end
		ui.rows = {}
		for i, o in ipairs(options) do
			local b = mk("TextButton", {
				Text = tostring(o), Size = UDim2.new(1, -6, 0, ROW), BackgroundColor3 = C.input, BorderSizePixel = 0,
				Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = C.text, AutoButtonColor = false, LayoutOrder = i,
			}, holder)
			round(b, 4)
			local r = { btn = b, name = tostring(o), value = o, on = false }
			b.MouseButton1Click:Connect(function() onClick(o, r) end)
			ui.rows[#ui.rows + 1] = r
		end
		ui.resize()
	end
	return ui
end

function TabMT:CreateDropdown(t, options, default, callback, flag)
	options = options or {}
	local selected = default
	local function exists(v)
		for _, o in ipairs(options) do if tostring(o) == tostring(v) then return true end end
		return false
	end
	if not exists(selected) then selected = options[1] end
	local ui = newDropdown(self, t or "Dropdown", false)
	local obj = { Instance = ui.card, Type = "Dropdown", Default = default }
	local function paint()
		for _, r in ipairs(ui.rows) do ui.paint(r, selected ~= nil and r.name == tostring(selected)) end
		ui.setValue(selected ~= nil and tostring(selected) or "Select...")
	end
	local function build()
		ui.build(options, function(o) obj:Set(o); ui.setOpen(false) end)
		paint()
	end
	function obj:Get() return selected end
	function obj:Set(v, silent)
		if not exists(v) then return end
		local changed = tostring(v) ~= tostring(selected)
		selected = v
		paint()
		if changed then emit(obj, silent) end
	end
	function obj:Reset()
		if exists(default) then obj:Set(default) elseif options[1] ~= nil then obj:Set(options[1]) end
	end
	function obj:Refresh(newOptions)
		options = newOptions or {}
		if not exists(selected) then selected = options[1] end
		build()
	end
	obj.SetValues = obj.Refresh
	build()
	return register(obj, flag, callback)
end

function TabMT:CreateMultiDropdown(t, options, defaults, callback, flag)
	options = options or {}
	local selected = {}
	for _, v in ipairs(defaults or {}) do selected[tostring(v)] = true end
	local ui = newDropdown(self, t or "Multi", true)
	local obj = { Instance = ui.card, Type = "MultiDropdown", Default = defaults or {} }
	local function getList()
		local out = {}
		for _, o in ipairs(options) do if selected[tostring(o)] then out[#out + 1] = tostring(o) end end
		return out
	end
	local function paint()
		for _, r in ipairs(ui.rows) do ui.paint(r, selected[r.name] == true) end
		local l = getList()
		if #l == 0 then ui.setValue("None")
		elseif #l == 1 then ui.setValue(l[1])
		else ui.setValue(#l .. " selected") end
	end
	local function build()
		ui.build(options, function(_, r)
			selected[r.name] = not selected[r.name] or nil
			paint()
			emit(obj, false)
		end)
		paint()
	end
	function obj:Get() return getList() end
	function obj:Set(list, silent)
		selected = {}
		for _, v in ipairs(list or {}) do selected[tostring(v)] = true end
		paint()
		emit(obj, silent)
	end
	function obj:Reset() obj:Set(obj.Default) end
	function obj:Refresh(newOptions)
		options = newOptions or {}
		local keep = {}
		for _, o in ipairs(options) do if selected[tostring(o)] then keep[tostring(o)] = true end end
		selected = keep
		build()
	end
	obj.SetValues = obj.Refresh
	build()
	return register(obj, flag, callback)
end

