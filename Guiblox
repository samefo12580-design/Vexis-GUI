local Library = {
	Version = "3.1.0",
	Flags = {},
	Elements = {},
	Windows = {},
	Accent = Color3.fromRGB(225, 55, 65),
	FireOnInit = true,
}

local C = {
	bg = Color3.fromRGB(22, 22, 26),
	side = Color3.fromRGB(17, 17, 20),
	card = Color3.fromRGB(33, 33, 39),
	hover = Color3.fromRGB(43, 43, 51),
	input = Color3.fromRGB(26, 26, 31),
	line = Color3.fromRGB(52, 52, 60),
	text = Color3.fromRGB(235, 235, 240),
	sub = Color3.fromRGB(150, 150, 162),
	white = Color3.new(1, 1, 1),
}

local conns, keyHandlers = {}, {}
local dragFn, dragEnd, openDD
local inited = false
local TabMT = {}
TabMT.__index = TabMT
local WindowMT = {}
WindowMT.__index = WindowMT

local function mk(class, props, parent)
	local i = newInst(class)
	for k, v in pairs(props) do i[k] = v end
	if parent then i.Parent = parent end
	return i
end

local function round(p, r)
	return mk("UICorner", { CornerRadius = UDim.new(0, r or 6) }, p)
end

local function padding(p, l, t, r, b)
	return mk("UIPadding", {
		PaddingLeft = UDim.new(0, l or 0), PaddingTop = UDim.new(0, t or 0),
		PaddingRight = UDim.new(0, r or 0), PaddingBottom = UDim.new(0, b or 0),
	}, p)
end

local function layout(p, gap)
	return mk("UIListLayout", { Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder }, p)
end

local function text(parent, props)
	props.BackgroundTransparency = 1
	props.Font = props.Font or Enum.Font.Gotham
	props.TextSize = props.TextSize or 13
	props.TextColor3 = props.TextColor3 or C.text
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Left
	return mk("TextLabel", props, parent)
end

local function safe(fn, ...)
	if type(fn) ~= "function" then return end
	local ok, err = pcall(fn, ...)
	if not ok then warn("[VortexUI] " .. tostring(err)) end
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

local function connect(signal, fn)
	local c = signal:Connect(fn)
	conns[#conns + 1] = c
	return c
end

local function viewport()
	local cam = workspace.CurrentCamera
	return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

local function init()
	if inited then return end
	inited = true
	connect(UIS.InputChanged, function(input)
		if dragFn and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			safe(dragFn, input)
		end
	end)
	connect(UIS.InputEnded, function(input)
		if isPress(input) then
			local e = dragEnd
			dragFn, dragEnd = nil, nil
			if e then safe(e) end
		end
	end)
	connect(UIS.InputBegan, function(input, gpe)
		for _, h in ipairs(keyHandlers) do h(input, gpe) end
	end)
end

local function startDrag(fn, onEnd)
	dragFn, dragEnd = fn, onEnd
end

local function nextOrder(tab)
	tab.n = (tab.n or 0) + 1
	return tab.n
end

local function register(obj, flag, cb, noInit)
	obj.Flag = flag
	obj.Callback = cb
	function obj:SetVisible(v) obj.Instance.Visible = v ~= false end
	function obj:Destroy()
		obj.Instance:Destroy()
		if flag then
			Library.Elements[flag] = nil
			Library.Flags[flag] = nil
		end
	end
	if flag then
		Library.Elements[flag] = obj
		Library.Flags[flag] = obj:Get()
	end
	if Library.FireOnInit and cb and not noInit then
		task.defer(safe, cb, obj:Get())
	end
	return obj
end

local function emit(obj, silent)
	local v = obj:Get()
	if obj.Flag then Library.Flags[obj.Flag] = v end
	if not silent then safe(obj.Callback, v) end
end

local function card(tab, h)
	local f = mk("Frame", {
		Size = UDim2.new(1, 0, 0, h or 34), BackgroundColor3 = C.card, BorderSizePixel = 0,
		ClipsDescendants = true, LayoutOrder = nextOrder(tab),
	}, tab.Page)
	round(f, 6)
	return f
end

local function toHex(c)
	return string.format("%02X%02X%02X", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

local function fromHex(s)
	local r, g, b = tostring(s):match("^#?(%x%x)(%x%x)(%x%x)$")
	if not r then return nil end
	return Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
end

local notifHolder

function Library:Notify(title, body, duration, kind)
	if not notifHolder then return end
	duration = tonumber(duration) or 3
	local k = tostring(kind or ""):lower()
	local col = ({
		success = Color3.fromRGB(80, 200, 120),
		error = Color3.fromRGB(235, 80, 80),
		warning = Color3.fromRGB(240, 180, 70),
		warn = Color3.fromRGB(240, 180, 70),
	})[k] or Library.Accent
	local f = mk("Frame", {
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = C.card, BorderSizePixel = 0,
	}, notifHolder)
	round(f, 6)
	mk("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = col, BorderSizePixel = 0 }, f)
	local inner = mk("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, f)
	padding(inner, 12, 8, 8, 8)
	layout(inner, 2)
	text(inner, { Text = tostring(title or "Notification"), Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1, TextTruncate = Enum.TextTruncate.AtEnd })
	text(inner, {
		Text = tostring(body or ""), TextSize = 12, TextColor3 = C.sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
	})
	task.delay(duration, function() f:Destroy() end)
end

function Library:SetTheme() return false end
function Library:SetAccent(color) if typeof(color) == "Color3" then self.Accent = color end end

function Library:Unload()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	for _, w in ipairs(self.Windows) do pcall(function() w.ScreenGui:Destroy() end) end
	conns, keyHandlers, self.Windows = {}, {}, {}
	for k in pairs(self.Flags) do self.Flags[k] = nil end
	for k in pairs(self.Elements) do self.Elements[k] = nil end
	inited, openDD, dragFn, dragEnd, notifHolder = false, nil, nil, nil, nil
end

