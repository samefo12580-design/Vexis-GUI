	local t = text(f, { Text = tostring(title or ""), Font = Enum.Font.GothamBold, Size = UDim2.new(1, 0, 0, 16), LayoutOrder = 1, Visible = hasTitle })
	local c = text(f, {
		Text = tostring(content or ""), TextSize = 12, TextColor3 = C.sub, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top,
		Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2,
	})
	return {
		Instance = f,
		SetTitle = function(_, s) t.Text = tostring(s); t.Visible = tostring(s) ~= "" end,
		GetContent = function() return c.Text end,
		SetContent = function(_, s, color) c.Text = tostring(s); c.TextColor3 = color or C.sub end,
	}
end

